<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    :root {
      --cream: #F7F2EC;
      --cream-dark: #EFE7DC;
      --terracotta: #C97B5C;
      --terracotta-dark: #B5684C;
      --sage: #5C7A6A;
      --sage-light: #7E9788;
      --charcoal: #2C2C2C;
      --gold: #D4A574;
      --blush: #E8C5B8;
      --muted: #6B6B6B;
      --line: #E5DDD2;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--charcoal);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 {
      font-family: 'DM Serif Display', serif;
      font-weight: 400;
      line-height: 1.15;
      color: var(--charcoal);
    }
    a { color: inherit; text-decoration: none; cursor: pointer; }
    img { display: block; max-width: 100%; height: auto; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

    /* Announcement bar */
    .phase-announce {
      background: var(--sage);
      color: #fff;
      font-size: 13px;
      text-align: center;
      padding: 10px 16px;
      letter-spacing: .5px;
    }
    .phase-announce strong { font-weight: 600; }

    /* Header */
    .phase-header {
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .phase-header .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 0;
    }
    .phase-logo {
      font-family: 'DM Serif Display', serif;
      font-size: 28px;
      letter-spacing: 1px;
      color: var(--charcoal);
    }
    .phase-logo span { color: var(--terracotta); }
    .phase-nav-links {
      display: flex;
      gap: 32px;
      font-size: 14px;
      font-weight: 500;
    }
    .phase-nav-links a { transition: color .2s; }
    .phase-nav-links a:hover { color: var(--terracotta); }
    .phase-nav-actions { display: flex; gap: 12px; align-items: center; }
    .phase-icon-btn {
      width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 50%;
      transition: background .2s;
      font-size: 18px;
      position: relative;
      color: var(--charcoal);
    }
    .phase-icon-btn:hover { background: var(--cream-dark); }
    .phase-cart-count {
      position: absolute; top: 2px; right: 2px;
      background: var(--terracotta); color: #fff;
      border-radius: 50%; width: 18px; height: 18px;
      font-size: 11px; display: flex; align-items: center; justify-content: center;
      font-weight: 600;
    }
    .phase-cart-count[data-count="0"] { display: none; }
    @media (max-width: 840px) { .phase-nav-links { display: none; } }

    /* Buttons (global) */
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 16px 32px; font-size: 14px; font-weight: 600;
      letter-spacing: 1px; text-transform: uppercase; border-radius: 2px;
      transition: all .25s; justify-content: center; cursor: pointer; border: none;
      font-family: 'DM Sans', sans-serif;
    }
    .btn-primary { background: var(--terracotta); color: #fff; }
    .btn-primary:hover { background: var(--terracotta-dark); transform: translateY(-1px); }
    .btn-ghost {
      background: transparent; color: var(--charcoal);
      text-decoration: underline; text-underline-offset: 6px; padding: 16px 8px;
    }
    .btn-outline { background: transparent; color: var(--charcoal); border: 1.5px solid var(--charcoal); }
    .btn-outline:hover { background: var(--charcoal); color: #fff; }

    /* Section base */
    .section-head { text-align: center; max-width: 700px; margin: 0 auto 60px; }
    .section-eyebrow {
      color: var(--terracotta); font-size: 12px; font-weight: 600;
      letter-spacing: 3px; text-transform: uppercase; margin-bottom: 16px;
    }
    .section-head h2 { font-size: 48px; margin-bottom: 18px; }
    .section-head p { color: var(--muted); font-size: 17px; }
    @media (max-width: 700px) { .section-head h2 { font-size: 32px; } }

    /* Footer */
    .phase-footer {
      background: var(--charcoal);
      color: #fff;
      padding: 70px 0 30px;
    }
    .phase-footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 50px;
      margin-bottom: 50px;
    }
    .phase-footer-col h4 {
      font-family: 'DM Sans', sans-serif;
      font-size: 13px; font-weight: 600;
      letter-spacing: 2px; text-transform: uppercase;
      margin-bottom: 20px; color: var(--gold);
    }
    .phase-footer-col ul { list-style: none; }
    .phase-footer-col li { margin-bottom: 12px; font-size: 14px; opacity: .8; }
    .phase-footer-col li a:hover { opacity: 1; color: var(--blush); }
    .phase-footer-brand .phase-logo { color: #fff; margin-bottom: 16px; display: block; }
    .phase-footer-brand p { font-size: 14px; opacity: .7; line-height: 1.6; }
    .phase-footer-bottom {
      border-top: 1px solid rgba(255,255,255,.1);
      padding-top: 24px;
      display: flex; justify-content: space-between;
      font-size: 12px; opacity: .6; flex-wrap: wrap; gap: 16px;
    }
    @media (max-width: 900px) { .phase-footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; } }
    @media (max-width: 560px) { .phase-footer-grid { grid-template-columns: 1fr; } }

    /* Skip link */
    .skip-link { position: absolute; left: -9999px; }
    .skip-link:focus { left: 0; top: 0; z-index: 200; padding: 8px 16px; background: var(--terracotta); color: #fff; }
  </style>

  <!-- Phase® Meta Pixel -->
  <script>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '947471684581402');
  fbq('track', 'PageView');
  {% if template == 'product' %}
    fbq('track', 'ViewContent', {
      content_ids: ['{{ product.id }}'],
      content_name: '{{ product.title | escape }}',
      content_type: 'product',
      value: {{ product.price | money_without_currency }},
      currency: '{{ shop.currency }}'
    });
  {% endif %}
  {% if template == 'cart' %}
    fbq('track', 'InitiateCheckout', {
      value: {{ cart.total_price | money_without_currency }},
      currency: '{{ shop.currency }}',
      num_items: {{ cart.item_count }}
    });
  {% endif %}
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=947471684581402&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel -->
</head>

<body class="template-{{ template | replace: '.', '-' | handleize }}">
  <a href="#MainContent" class="skip-link">Skip to content</a>

  <div class="phase-announce">
    Free shipping on orders over $50 &middot; 60-day relief guarantee &middot; <strong>Subscribe &amp; save 15%</strong>
  </div>

  <div class="phase-announcement-bar" id="phase-announcement">
    <div class="phase-announcement-inner">
      <span>🌿 Free shipping on orders $75+ &nbsp;·&nbsp; 60-day money-back guarantee &nbsp;·&nbsp; New: Hormone Harmony Kit — Save 20%</span>
      <button class="phase-ann-close" onclick="this.closest('#phase-announcement').style.display='none'" aria-label="Close">&times;</button>
    </div>
  </div>
  <style>
  .phase-announcement-bar {
    background: var(--terracotta); color: #fff;
    text-align: center; padding: 9px 40px;
    font-size: 13px; font-weight: 500;
    position: relative;
    font-family: 'DM Sans', sans-serif;
  }
  .phase-announcement-inner { max-width: 900px; margin: 0 auto; }
  .phase-ann-close {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    background: none; border: none; color: #fff; cursor: pointer;
    font-size: 18px; line-height: 1; opacity: .7;
  }
  .phase-ann-close:hover { opacity: 1; }
  </style>
  <header class="phase-header">
    <div class="container">
      <div class="nav">
        <a href="/" class="phase-logo">{{ shop.name }}<span>.</span></a>
        <nav class="phase-nav-links" aria-label="Main navigation">
          <a href="/collections/all">Shop All</a>
          <a href="/collections/hot-flashes">Hot Flashes</a>
          <a href="/collections/sleep">Sleep</a>
          <a href="/collections/hormone-support">Hormones</a>
          <a href="/collections/focus">Brain Fog</a>
          <a href="/pages/about">Our Story</a>
        </nav>
        <div class="phase-nav-actions">
          <a href="/search" class="phase-icon-btn" title="Search">⌕</a>
          <a href="/cart" class="phase-icon-btn" title="Cart">
            🛒
            {%- if cart.item_count > 0 -%}
            <span class="phase-cart-count">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>
  </header>

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  <footer class="phase-footer">
    <div class="container">
      <div class="phase-footer-grid">
        <div class="phase-footer-col phase-footer-brand">
          <span class="phase-logo">{{ shop.name }}<span style="color:var(--gold)">.</span></span>
          <p>Doctor-formulated, women-founded relief for every phase of menopause. Made with you in mind.</p>
        </div>
        <div class="phase-footer-col">
          <h4>Shop</h4>
          <ul>
            <li><a href="/collections/all">All Products</a></li>
            <li><a href="/collections/hot-flashes">By Symptom</a></li>
            <li><a href="/pages/find-your-protocol">Take the Quiz</a></li>
          </ul>
        </div>
        <div class="phase-footer-col">
          <h4>Learn</h4>
          <ul>
            <li><a href="/pages/about">Our Story</a></li>
            <li><a href="/blogs/news">Journal</a></li>
          </ul>
        </div>
        <div class="phase-footer-col">
          <h4>Help</h4>
          <ul>
            <li><a href="/policies/shipping-policy">Shipping</a></li>
            <li><a href="/policies/refund-policy">Returns</a></li>
            <li><a href="/policies/privacy-policy">Privacy</a></li>
            <li><a href="/policies/terms-of-service">Terms</a></li>
          </ul>
          <h4 style="margin-top:24px">Text us</h4>
          <ul>
            <li><a href="tel:+19784965301" style="color:var(--blush);font-weight:600">+1 (978) 496-5301</a></li>
            <li style="font-size:12px;opacity:.6">WhatsApp &middot; iMessage &middot; SMS welcome</li>
          </ul>
        </div>
      </div>
      <div class="phase-footer-bottom">
        <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
        <div>Privacy &middot; Terms &middot; Accessibility</div>
      </div>
    </div>
  </footer>
</body>
</html>
