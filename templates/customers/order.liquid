<div style="max-width:880px;margin:48px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:36px;">Order {{ order.name }}</h1>
  <p style="color:rgba(44,44,44,0.7);">Placed on {{ order.created_at | date: '%b %d, %Y' }}</p>

  <table style="width:100%;border-collapse:collapse;margin-top:24px;">
    <thead>
      <tr style="text-align:left;border-bottom:1px solid rgba(44,44,44,0.1);">
        <th style="padding:10px 8px;">Item</th>
        <th style="padding:10px 8px;">Qty</th>
        <th style="padding:10px 8px;">Total</th>
      </tr>
    </thead>
    <tbody>
      {% for line_item in order.line_items %}
        <tr style="border-bottom:1px solid rgba(44,44,44,0.05);">
          <td style="padding:10px 8px;">{{ line_item.title }}</td>
          <td style="padding:10px 8px;">{{ line_item.quantity }}</td>
          <td style="padding:10px 8px;">{{ line_item.final_line_price | money }}</td>
        </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr><td colspan="2" style="padding:10px 8px;text-align:right;">Subtotal</td><td style="padding:10px 8px;">{{ order.subtotal_price | money }}</td></tr>
      <tr><td colspan="2" style="padding:10px 8px;text-align:right;">Shipping</td><td style="padding:10px 8px;">{{ order.shipping_price | money }}</td></tr>
      <tr><td colspan="2" style="padding:10px 8px;text-align:right;"><strong>Total</strong></td><td style="padding:10px 8px;"><strong>{{ order.total_price | money }}</strong></td></tr>
    </tfoot>
  </table>
</div>
