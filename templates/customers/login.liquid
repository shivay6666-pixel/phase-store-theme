<div style="max-width:420px;margin:64px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:36px;text-align:center;margin-bottom:24px;">Login</h1>
  {% form 'customer_login' %}
    {{ form.errors | default_errors }}
    <label style="display:block;margin-bottom:6px;font-size:14px;">Email</label>
    <input type="email" name="customer[email]" required style="width:100%;padding:12px 16px;border:1px solid rgba(44,44,44,0.15);border-radius:8px;margin-bottom:16px;">
    <label style="display:block;margin-bottom:6px;font-size:14px;">Password</label>
    <input type="password" name="customer[password]" required style="width:100%;padding:12px 16px;border:1px solid rgba(44,44,44,0.15);border-radius:8px;margin-bottom:16px;">
    <button type="submit" style="width:100%;background:var(--charcoal);color:var(--cream);padding:14px;border:none;border-radius:999px;font-weight:500;cursor:pointer;">Sign In</button>
    <div style="margin-top:16px;text-align:center;font-size:14px;">
      <a href="/account/register">Create account</a> &middot; <a href="#" onclick="document.getElementById('recover').style.display='block';return false;">Forgot password?</a>
    </div>
  {% endform %}
  <div id="recover" style="display:none;margin-top:24px;">
    {% form 'recover_customer_password' %}
      {{ form.errors | default_errors }}
      <label style="display:block;margin-bottom:6px;font-size:14px;">Email</label>
      <input type="email" name="email" required style="width:100%;padding:12px 16px;border:1px solid rgba(44,44,44,0.15);border-radius:8px;margin-bottom:16px;">
      <button type="submit" style="width:100%;background:var(--terracotta);color:var(--cream);padding:14px;border:none;border-radius:999px;font-weight:500;cursor:pointer;">Send reset link</button>
    {% endform %}
  </div>
</div>
