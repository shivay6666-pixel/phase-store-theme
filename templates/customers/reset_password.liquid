<div style="max-width:420px;margin:64px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:32px;text-align:center;">Reset Password</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <label style="display:block;margin:16px 0 6px;font-size:14px;">New password</label>
    <input type="password" name="customer[password]" required style="width:100%;padding:12px 16px;border:1px solid rgba(44,44,44,0.15);border-radius:8px;">
    <label style="display:block;margin:16px 0 6px;font-size:14px;">Confirm</label>
    <input type="password" name="customer[password_confirmation]" required style="width:100%;padding:12px 16px;border:1px solid rgba(44,44,44,0.15);border-radius:8px;">
    <button type="submit" style="width:100%;margin-top:16px;background:var(--charcoal);color:var(--cream);padding:14px;border:none;border-radius:999px;font-weight:500;cursor:pointer;">Reset</button>
  {% endform %}
</div>
