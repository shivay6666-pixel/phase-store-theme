<div style="max-width:880px;margin:48px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:40px;">My Account</h1>
  <p style="color:rgba(44,44,44,0.7);margin-bottom:24px;">Hi {{ customer.first_name }} &middot; <a href="/account/logout">Log out</a></p>

  <h2 style="font-family:var(--serif);font-size:24px;margin-top:32px;">Order history</h2>
  {% if customer.orders.size > 0 %}
    <table style="width:100%;border-collapse:collapse;margin-top:12px;">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid rgba(44,44,44,0.1);">
          <th style="padding:10px 8px;">Order</th>
          <th style="padding:10px 8px;">Date</th>
          <th style="padding:10px 8px;">Total</th>
          <th style="padding:10px 8px;">Status</th>
        </tr>
      </thead>
      <tbody>
        {% for order in customer.orders %}
          <tr style="border-bottom:1px solid rgba(44,44,44,0.05);">
            <td style="padding:10px 8px;"><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td style="padding:10px 8px;">{{ order.created_at | date: '%b %d, %Y' }}</td>
            <td style="padding:10px 8px;">{{ order.total_price | money }}</td>
            <td style="padding:10px 8px;">{{ order.fulfillment_status_label }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p>You haven't placed any orders yet.</p>
  {% endif %}

  <h2 style="font-family:var(--serif);font-size:24px;margin-top:40px;">Address</h2>
  <p><a href="/account/addresses">View addresses ({{ customer.addresses_count }})</a></p>
</div>
