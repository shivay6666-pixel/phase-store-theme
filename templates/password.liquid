<div style="min-height:80vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:48px 24px;">
  <div style="max-width:480px;">
    <h1 style="font-family:var(--serif);font-size:48px;margin:0 0 12px;">Opening Soon</h1>
    <p style="color:rgba(44,44,44,0.7);font-size:17px;margin-bottom:32px;">Sign up to be the first to know when we launch.</p>
    {% form 'storefront_password' %}
      <input type="password" name="password" placeholder="Password" required style="width:100%;padding:14px 18px;border:1px solid rgba(44,44,44,0.15);border-radius:999px;font-size:15px;margin-bottom:12px;">
      <button type="submit" style="background:var(--charcoal);color:var(--cream);padding:14px 28px;border:none;border-radius:999px;font-size:15px;font-weight:500;cursor:pointer;">Enter</button>
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
</div>
