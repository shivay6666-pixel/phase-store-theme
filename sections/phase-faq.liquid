<style>
  .phase-faq-section {
    padding: 100px 0;
    background: var(--cream);
  }
  .phase-faq-list { max-width: 780px; margin: 0 auto; }
  .phase-faq-item { border-bottom: 1px solid var(--line); padding: 24px 0; }
  .phase-faq-q {
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer; font-size: 18px; font-weight: 600;
    background: none; border: none; width: 100%; text-align: left;
    color: var(--charcoal); font-family: 'DM Sans', sans-serif;
    padding: 0;
  }
  .phase-faq-q::after {
    content: "+"; font-size: 24px;
    color: var(--terracotta); font-weight: 300; flex-shrink: 0; margin-left: 16px;
  }
  .phase-faq-item.open .phase-faq-q::after { content: "−"; }
  .phase-faq-a {
    max-height: 0; overflow: hidden;
    transition: max-height .35s ease, padding .35s ease;
    color: var(--muted); font-size: 15px; line-height: 1.7;
  }
  .phase-faq-item.open .phase-faq-a { max-height: 300px; padding-top: 14px; }
</style>

<section class="phase-faq-section">
  <div class="container">
    <div class="section-head">
      <div class="section-eyebrow">Questions, answered</div>
      <h2>The things you'd ask a friend</h2>
    </div>
    <div class="phase-faq-list">
      {% for block in section.blocks %}
        <div class="phase-faq-item" {{ block.shopify_attributes }}>
          <button class="phase-faq-q" aria-expanded="false">{{ block.settings.question }}</button>
          <div class="phase-faq-a">{{ block.settings.answer }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.phase-faq-q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = this.closest('.phase-faq-item');
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.phase-faq-item.open').forEach(function(el) {
        el.classList.remove('open');
        el.querySelector('.phase-faq-q').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        this.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Phase FAQ",
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Phase FAQ" }]
}
{% endschema %}
