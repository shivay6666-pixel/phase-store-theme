<style>
  .phase-founder {
    padding: 100px 0;
    background: var(--cream);
  }
  .phase-founder-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }
  .phase-founder-image img {
    width: 100%; height: 580px;
    object-fit: cover;
    border-radius: 4px;
  }
  .phase-founder-content h2 { font-size: 44px; margin-bottom: 24px; }
  .phase-founder-quote {
    font-family: 'DM Serif Display', serif;
    font-size: 24px; font-style: italic;
    color: var(--sage);
    margin-bottom: 24px;
    line-height: 1.4;
  }
  .phase-founder-content p { color: var(--muted); font-size: 16px; margin-bottom: 18px; }
  .phase-founder-sig {
    margin-top: 30px;
    font-family: 'DM Serif Display', serif;
    font-size: 22px;
  }
  .phase-founder-sig small {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; color: var(--muted);
    font-weight: 500; letter-spacing: 1px;
    text-transform: uppercase; margin-top: 4px;
  }
  @media (max-width: 900px) {
    .phase-founder-grid { grid-template-columns: 1fr; gap: 40px; }
    .phase-founder-image img { height: 420px; }
  }
</style>

<section class="phase-founder">
  <div class="container">
    <div class="phase-founder-grid">
      <div class="phase-founder-image">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}"
               alt="{{ section.settings.image.alt | escape }}" loading="lazy" />
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=800&q=85&auto=format&fit=crop"
               alt="Margaret — Founder of Phase" loading="lazy" />
        {%- endif -%}
      </div>
      <div class="phase-founder-content">
        <div class="section-eyebrow">Why Phase exists</div>
        <h2>{{ section.settings.heading }}</h2>
        <p class="phase-founder-quote">{{ section.settings.quote }}</p>
        <p>{{ section.settings.body_1 }}</p>
        <p>{{ section.settings.body_2 }}</p>
        <div class="phase-founder-sig">
          {{ section.settings.sig_name }}
          <small>{{ section.settings.sig_title }}</small>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Founder",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder photo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "I started Phase at 54, in the middle of my own." },
    { "type": "textarea", "id": "quote", "label": "Pull quote", "default": "\"I was a mess for two years before I figured out what was happening to my body. I built Phase so no woman has to figure it out alone.\"" },
    { "type": "textarea", "id": "body_1", "label": "Body paragraph 1", "default": "I'm Margaret. I spent 22 years as a clinical nutritionist before menopause hit me like a freight train at 51. My doctor offered HRT or \"lifestyle changes.\" Neither fixed the 3am wake-ups, the brain fog in client meetings, or the hot flashes that left me red-faced in the cereal aisle." },
    { "type": "textarea", "id": "body_2", "label": "Body paragraph 2", "default": "I started formulating with two friends — a women's health pharmacist and a sleep researcher — to make the things I couldn't find. Now we make them for 12,000 other women. Every product is something I take, my mother takes, or my daughter is preparing to take." },
    { "type": "text", "id": "sig_name", "label": "Signature name", "default": "— Margaret Chen" },
    { "type": "text", "id": "sig_title", "label": "Signature title", "default": "Founder · CN, Clinical Nutritionist" }
  ],
  "presets": [{ "name": "Phase Founder" }]
}
{% endschema %}
