<style>
  .phase-science {
    padding: 80px 0;
    background: var(--charcoal);
    color: #fff;
  }
  .phase-science-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    text-align: center;
  }
  .phase-science-item h3 {
    font-family: 'DM Serif Display', serif;
    font-size: 48px;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .phase-science-item p { font-size: 14px; opacity: .8; color: #fff; }
  @media (max-width: 760px) {
    .phase-science-grid { grid-template-columns: repeat(2, 1fr); gap: 30px; }
  }
</style>

<section class="phase-science">
  <div class="container">
    <div class="phase-science-grid">
      {% for block in section.blocks %}
        <div class="phase-science-item" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.stat }}</h3>
          <p>{{ block.settings.label }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Science Strip",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "stat", "label": "Stat", "default": "94%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Report symptom relief within 30 days" }
      ]
    }
  ],
  "presets": [{
    "name": "Phase Science Strip",
    "blocks": [
      { "type": "stat", "settings": { "stat": "12k+", "label": "Women supported across 23 countries" } },
      { "type": "stat", "settings": { "stat": "94%", "label": "Report symptom relief within 30 days" } },
      { "type": "stat", "settings": { "stat": "0", "label": "Parabens, sulfates, or hormone disruptors" } },
      { "type": "stat", "settings": { "stat": "60", "label": "Day money-back relief guarantee" } }
    ]
  }]
}
{% endschema %}
