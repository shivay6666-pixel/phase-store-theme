{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}

<style>
  .coll-page { max-width: 1280px; margin: 48px auto; padding: 0 24px; }
  .coll-page__head { text-align: center; margin-bottom: 40px; }
  .coll-page__title { font-family: var(--serif); font-size: 44px; margin: 0 0 8px; }
  .coll-page__desc { color: rgba(44,44,44,0.7); max-width: 560px; margin: 0 auto; }
  .coll-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  @media (max-width: 1024px) { .coll-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) { .coll-grid { grid-template-columns: repeat(2, 1fr); } }
  .coll-card { background: #fff; border-radius: 12px; overflow: hidden; transition: transform 0.2s; }
  .coll-card:hover { transform: translateY(-3px); }
  .coll-card a { color: inherit; text-decoration: none; }
  .coll-card__img { aspect-ratio: 1; overflow: hidden; background: var(--cream-alt); }
  .coll-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .coll-card__body { padding: 16px 18px 20px; }
  .coll-card__title { font-family: var(--serif); font-size: 18px; margin: 0 0 6px; }
  .coll-card__price { color: var(--terracotta); font-weight: 500; font-size: 15px; }
</style>

<div class="coll-page">
  <div class="coll-page__head">
    <h1 class="coll-page__title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="coll-page__desc">{{ collection.description }}</div>
    {% endif %}
  </div>
  <div class="coll-grid">
    {% paginate collection.products by 24 %}
      {% for product in collection.products %}
        <div class="coll-card">
          <a href="{{ product.url }}">
            <div class="coll-card__img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="coll-card__body">
              <div class="coll-card__title">{{ product.title }}</div>
              <div class="coll-card__price">{{ product.price | money }}</div>
            </div>
          </a>
        </div>
      {% endfor %}
    {% endpaginate %}
  </div>
</div>
