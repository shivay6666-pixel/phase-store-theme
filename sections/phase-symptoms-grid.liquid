<style>
  .phase-symptoms {
    padding: 100px 0;
    background: var(--cream);
  }
  .phase-symptom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .phase-symptom-card {
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    transition: all .3s;
    border: 1px solid var(--line);
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .phase-symptom-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px -20px rgba(60,40,30,.2);
  }
  .phase-symptom-card-img { height: 220px; overflow: hidden; }
  .phase-symptom-card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .5s;
  }
  .phase-symptom-card:hover .phase-symptom-card-img img { transform: scale(1.05); }
  .phase-symptom-card-body { padding: 28px; }
  .phase-symptom-card-body h3 { font-size: 24px; margin-bottom: 10px; }
  .phase-symptom-card-body p { color: var(--muted); font-size: 14px; margin-bottom: 16px; }
  .phase-symptom-card-body .arrow {
    color: var(--terracotta); font-size: 13px;
    font-weight: 600; letter-spacing: 1px; text-transform: uppercase;
  }
  @media (max-width: 900px) { .phase-symptom-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .phase-symptom-grid { grid-template-columns: 1fr; } }
</style>

<section class="phase-symptoms">
  <div class="container">
    <div class="section-head">
      <div class="section-eyebrow">Find your relief</div>
      <h2>Shop by what you're feeling today</h2>
      <p>Menopause isn't one symptom — it's a moving target. Start where it hurts most.</p>
    </div>
    <div class="phase-symptom-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="phase-symptom-card" {{ block.shopify_attributes }}>
          <div class="phase-symptom-card-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}"
                   alt="{{ block.settings.title }}" loading="lazy" />
            {% else %}
              <img src="{{ block.settings.fallback_url }}"
                   alt="{{ block.settings.title }}" loading="lazy" />
            {% endif %}
          </div>
          <div class="phase-symptom-card-body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <div class="arrow">{{ block.settings.cta }} &rarr;</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Symptoms Grid",
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "cta", "label": "CTA text", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_url", "label": "Fallback image URL" }
      ]
    }
  ],
  "presets": [{ "name": "Phase Symptoms Grid" }]
}
{% endschema %}
