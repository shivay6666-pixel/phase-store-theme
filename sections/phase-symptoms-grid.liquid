{% comment %}
  Phase Symptoms Grid — links visitors to symptom-specific collections.
  Each card links to a collection (e.g., /collections/hot-flashes).
{% endcomment %}

<style>
  .phase-symp{padding:100px 0;background:#F7F2EC;}
  .phase-symp .container{max-width:1280px;margin:0 auto;padding:0 24px;}
  .phase-symp .head{text-align:center;max-width:700px;margin:0 auto 60px;}
  .phase-symp .eyebrow{color:#C97B5C;font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;margin-bottom:16px;}
  .phase-symp h2{font-family:'DM Serif Display',serif;font-size:48px;color:#2C2C2C;margin-bottom:18px;line-height:1.15;}
  .phase-symp .sub{color:#6B6B6B;font-size:17px;}
  .phase-symp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .phase-symp-card{background:#fff;border-radius:6px;overflow:hidden;border:1px solid #E5DDD2;text-decoration:none;color:inherit;display:block;transition:all .3s;}
  .phase-symp-card:hover{transform:translateY(-6px);box-shadow:0 24px 50px -20px rgba(60,40,30,.2);}
  .phase-symp-img{height:220px;overflow:hidden;}
  .phase-symp-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s;}
  .phase-symp-card:hover .phase-symp-img img{transform:scale(1.05);}
  .phase-symp-body{padding:28px;}
  .phase-symp-body h3{font-family:'DM Serif Display',serif;font-size:24px;margin:0 0 10px;color:#2C2C2C;}
  .phase-symp-body p{color:#6B6B6B;font-size:14px;margin:0 0 16px;}
  .phase-symp-arrow{color:#C97B5C;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;}
  @media(max-width:900px){.phase-symp-grid{grid-template-columns:repeat(2,1fr);} .phase-symp h2{font-size:32px;}}
  @media(max-width:600px){.phase-symp-grid{grid-template-columns:1fr;}}
</style>

<section class="phase-symp">
  <div class="container">
    <div class="head">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="sub">{{ section.settings.subhead }}</p>
    </div>
    <div class="phase-symp-grid">
      {% for block in section.blocks %}
        <a class="phase-symp-card" href="{{ block.settings.link | default: '#' }}">
          <div class="phase-symp-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
            {% else %}
              <img src="{{ block.settings.fallback_url }}" alt="{{ block.settings.title | escape }}" />
            {% endif %}
          </div>
          <div class="phase-symp-body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <div class="phase-symp-arrow">{{ block.settings.cta }} →</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Symptoms",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your relief" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by what you're feeling today" },
    { "type": "text", "id": "subhead", "label": "Subhead", "default": "Menopause isn't one symptom — it's a moving target. Start where it hurts most." }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "fallback_url", "label": "Fallback image URL", "default": "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&q=80&auto=format&fit=crop" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hot Flashes" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Cooling sprays, neck fans, and night-sweat-busting essentials." },
        { "type": "text", "id": "cta", "label": "CTA text", "default": "Shop cooling" },
        { "type": "url", "id": "link", "label": "Link to collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Phase Symptoms",
      "blocks": [
        { "type": "symptom" }, { "type": "symptom" }, { "type": "symptom" },
        { "type": "symptom" }, { "type": "symptom" }, { "type": "symptom" }
      ]
    }
  ]
}
{% endschema %}
