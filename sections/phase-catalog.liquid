{% comment %}
  Phase Full Catalog Section.
  Pulls from the "All Products" collection by default — every product
  imported via PagePilot will automatically appear here.
{% endcomment %}

<style>
  .phase-cat{padding:100px 0;background:#EFE7DC;}
  .phase-cat .container{max-width:1280px;margin:0 auto;padding:0 24px;}
  .phase-cat .head{text-align:center;max-width:700px;margin:0 auto 60px;}
  .phase-cat .eyebrow{color:#C97B5C;font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;margin-bottom:16px;}
  .phase-cat h2{font-family:'DM Serif Display',serif;font-size:48px;color:#2C2C2C;margin-bottom:18px;line-height:1.15;}
  .phase-cat .sub{color:#6B6B6B;font-size:17px;}
  .phase-cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .phase-cat-card{background:#fff;border-radius:6px;overflow:hidden;text-decoration:none;color:inherit;display:block;transition:all .3s;}
  .phase-cat-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px -15px rgba(60,40,30,.18);}
  .phase-cat-img{aspect-ratio:1/1;background:#F7F2EC;overflow:hidden;}
  .phase-cat-img img{width:100%;height:100%;object-fit:cover;}
  .phase-cat-body{padding:20px;}
  .phase-cat-cat{font-size:11px;color:#6B6B6B;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px;}
  .phase-cat-card h4{font-family:'DM Sans',sans-serif;font-size:17px;font-weight:600;margin:0 0 6px;color:#2C2C2C;}
  .phase-cat-price{font-size:16px;font-weight:700;color:#C97B5C;display:flex;align-items:center;gap:8px;} .phase-cat-price .strike{color:#6B6B6B;text-decoration:line-through;font-weight:400;font-size:14px;}
  .phase-cat-cta{text-align:center;margin-top:50px;}
  .phase-btn{display:inline-block;padding:16px 32px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;letter-spacing:1px;text-transform:uppercase;border:none;border-radius:2px;background:#C97B5C;color:#fff;text-decoration:none;}
  @media(max-width:1000px){.phase-cat-grid{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:760px){.phase-cat-grid{grid-template-columns:repeat(2,1fr);} .phase-cat h2{font-size:32px;}}
</style>

<section class="phase-cat">
  <div class="container">
    <div class="head">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="sub">{{ section.settings.subhead }}</p>
    </div>

    {% assign all_products = collections[section.settings.collection].products %}
    {% if all_products.size == 0 %}
      {% assign all_products = collections.all.products %}
    {% endif %}

    <div class="phase-cat-grid">
      {% if all_products.size > 0 %}
        {% for product in all_products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="phase-cat-card">
            <div class="phase-cat-img">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy" />
              {% else %}
                <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80&auto=format&fit=crop" alt="{{ product.title | escape }}" />
              {% endif %}
            </div>
            <div class="phase-cat-body">
              {% if product.type != blank %}<div class="phase-cat-cat">{{ product.type }}</div>{% endif %}
              <h4>{{ product.title }}</h4>
              <div class="phase-cat-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="strike">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                {{ product.price | money }}
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          <div class="phase-cat-card">
            <div class="phase-cat-img"><img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80&auto=format&fit=crop" alt="Sample" /></div>
            <div class="phase-cat-body">
              <div class="phase-cat-cat">Sample</div>
              <h4>Import via PagePilot to populate</h4>
              <div class="phase-cat-price">$0.00</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="phase-cat-cta">
      <a href="/collections/all" class="phase-btn">Browse Full Collection →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Full Catalog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Full collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The complete Phase catalog" },
    { "type": "text", "id": "subhead", "label": "Subhead", "default": "Everything we make, in one place." },
    { "type": "collection", "id": "collection", "label": "Collection (defaults to All Products)" },
    { "type": "range", "id": "product_limit", "label": "Number of products to show", "min": 4, "max": 24, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Phase Full Catalog" }]
}
{% endschema %}
