{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}

<div style="max-width:1280px;margin:48px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:44px;text-align:center;margin:0 0 40px;">All Collections</h1>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
    {% for collection in collections %}
      <a href="{{ collection.url }}" style="color:inherit;text-decoration:none;">
        {% if collection.featured_image %}
          <img src="{{ collection.featured_image | image_url: width: 600 }}" style="border-radius:12px;aspect-ratio:1.4;object-fit:cover;width:100%;" alt="{{ collection.title | escape }}">
        {% endif %}
        <h3 style="font-family:var(--serif);font-size:22px;margin:12px 0 0;">{{ collection.title }}</h3>
      </a>
    {% endfor %}
  </div>
</div>
