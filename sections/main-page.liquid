<style>
  .phase-page-rte {
    max-width: 780px; margin: 60px auto; padding: 0 24px 100px;
  }
  .phase-page-rte h1 { font-size: 48px; margin-bottom: 24px; }
  .phase-page-rte img { border-radius: 6px; margin: 30px 0; }
  .phase-page-rte p { font-size: 17px; line-height: 1.75; color: var(--charcoal); margin-bottom: 18px; }
  .phase-page-rte h2 { font-size: 32px; margin: 40px 0 16px; }
  .phase-page-rte h3 { font-size: 24px; margin: 30px 0 12px; }
  .phase-page-rte ul, .phase-page-rte ol { padding-left: 24px; margin-bottom: 18px; }
  .phase-page-rte li { font-size: 16px; line-height: 1.7; color: var(--charcoal); margin-bottom: 8px; }
  .phase-page-rte a { color: var(--terracotta); text-decoration: underline; text-underline-offset: 3px; }
</style>

<article class="phase-page-rte">
  <h1>{{ page.title }}</h1>
  <div>{{ page.content }}</div>
</article>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
