{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}

<div style="max-width:1100px;margin:48px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:44px;text-align:center;margin:0 0 40px;">{{ blog.title }}</h1>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
    {% paginate blog.articles by 12 %}
      {% for article in blog.articles %}
        <a href="{{ article.url }}" style="color:inherit;text-decoration:none;">
          {% if article.image %}
            <img src="{{ article.image | image_url: width: 600 }}" style="border-radius:12px;aspect-ratio:1.2;object-fit:cover;width:100%;" alt="{{ article.title | escape }}">
          {% endif %}
          <h2 style="font-family:var(--serif);font-size:22px;margin:12px 0 4px;">{{ article.title }}</h2>
          <div style="font-size:13px;color:rgba(44,44,44,0.6);">{{ article.published_at | date: '%b %d, %Y' }}</div>
        </a>
      {% endfor %}
    {% endpaginate %}
  </div>
</div>
