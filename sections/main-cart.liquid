<style>
  .phase-cart-page { max-width: 960px; margin: 60px auto; padding: 0 24px 100px; }
  .phase-cart-page h1 { font-size: 42px; margin-bottom: 40px; }
  .phase-cart-item {
    display: grid; grid-template-columns: 90px 1fr auto auto;
    gap: 20px; align-items: center;
    padding: 20px 0; border-bottom: 1px solid var(--line);
  }
  .phase-cart-item img { width: 90px; height: 90px; object-fit: cover; border-radius: 4px; }
  .phase-cart-item h4 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
  .phase-cart-item .var { font-size: 13px; color: var(--muted); }
  .phase-cart-item input[type=number] {
    width: 52px; padding: 8px; text-align: center;
    border: 1.5px solid var(--line); border-radius: 2px;
    font-family: 'DM Sans', sans-serif; font-size: 14px; outline: none;
  }
  .phase-cart-price { font-weight: 600; font-size: 16px; }
  .phase-cart-foot {
    display: flex; justify-content: flex-end; align-items: center;
    gap: 32px; margin-top: 40px; flex-wrap: wrap;
  }
  .phase-cart-total { font-size: 22px; font-weight: 600; }
  .phase-cart-empty { text-align: center; padding: 80px 0; color: var(--muted); }
</style>

<div class="phase-cart-page">
  <h1>Your Cart</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <div class="phase-cart-item">
          {% if item.image %}
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" />
          {% else %}
            <div style="width:90px;height:90px;background:var(--cream-dark);border-radius:4px"></div>
          {% endif %}
          <div>
            <h4><a href="{{ item.url }}" style="color:var(--charcoal)">{{ item.product.title }}</a></h4>
            {% unless item.product.has_only_default_variant %}
              <div class="var">{{ item.variant.title }}</div>
            {% endunless %}
            <div style="font-size:13px;color:var(--muted);margin-top:4px">{{ item.variant.price | money }} each</div>
          </div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" />
          <div class="phase-cart-price">{{ item.final_line_price | money }}</div>
        </div>
      {% endfor %}
      <div class="phase-cart-foot">
        <button type="submit" name="update"
                style="background:none;border:none;color:var(--muted);text-decoration:underline;cursor:pointer;font-size:13px">
          Update cart
        </button>
        <div class="phase-cart-total">Subtotal: {{ cart.total_price | money }}</div>
        <button type="submit" name="checkout" class="btn btn-primary" style="padding:18px 36px;font-size:15px">
          Checkout &rarr;
        </button>
      </div>
    </form>
  {% else %}
    <div class="phase-cart-empty">
      <p style="font-size:18px;margin-bottom:24px">Your cart is empty.</p>
      <a href="/collections/all" class="btn btn-primary">Continue Shopping &rarr;</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
