<style>
  .phase-newsletter {
    background: var(--blush);
    padding: 80px 0;
    text-align: center;
  }
  .phase-newsletter h2 { font-size: 42px; margin-bottom: 14px; }
  .phase-newsletter p {
    color: var(--charcoal); opacity: .7;
    margin-bottom: 30px;
    max-width: 500px; margin-left: auto; margin-right: auto;
  }
  .phase-newsletter-form {
    display: flex;
    max-width: 480px; margin: 0 auto;
    gap: 8px;
  }
  .phase-newsletter-form input {
    flex: 1; padding: 16px 20px;
    border: 1px solid rgba(0,0,0,.1);
    background: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px; border-radius: 2px; outline: none;
  }
  .phase-newsletter-form input:focus { border-color: var(--terracotta); }
  .phase-newsletter-small {
    font-size: 12px; color: var(--charcoal);
    opacity: .6; margin-top: 14px;
  }
</style>

<section class="phase-newsletter">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body }}</p>
    {% form 'customer', id: 'phase-newsletter-form' %}
      <div class="phase-newsletter-form">
        <input type="email" name="contact[email]"
               placeholder="your@email.com" required />
        <button class="btn btn-primary" type="submit">Join</button>
      </div>
      <input type="hidden" name="contact[tags]" value="newsletter" />
    {% endform %}
    <p class="phase-newsletter-small">No spam. Unsubscribe anytime.</p>
  </div>
</section>

{% schema %}
{
  "name": "Phase Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the playbook we wish we'd had." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join 40,000+ women getting our weekly note on what's working — symptom science, doctor interviews, and reader stories. Plus 15% off your first order." }
  ],
  "presets": [{ "name": "Phase Newsletter" }]
}
{% endschema %}
