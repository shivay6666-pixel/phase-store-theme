{% comment %} Phase Newsletter signup section {% endcomment %}

<style>
  .phase-news{padding:80px 0;background:#E8C5B8;text-align:center;}
  .phase-news .container{max-width:1280px;margin:0 auto;padding:0 24px;}
  .phase-news h2{font-family:'DM Serif Display',serif;font-size:42px;color:#2C2C2C;margin-bottom:14px;line-height:1.15;}
  .phase-news p{color:#2C2C2C;opacity:.7;margin-bottom:30px;max-width:500px;margin-left:auto;margin-right:auto;}
  .phase-news-form{display:flex;max-width:480px;margin:0 auto;gap:8px;}
  .phase-news-form input{flex:1;padding:16px 20px;border:1px solid rgba(0,0,0,.1);background:#fff;font-family:inherit;font-size:14px;border-radius:2px;outline:none;}
  .phase-news-form button{padding:16px 28px;background:#C97B5C;color:#fff;border:none;font-weight:600;letter-spacing:1px;text-transform:uppercase;font-size:13px;cursor:pointer;border-radius:2px;}
  .phase-news small{display:block;font-size:12px;color:#2C2C2C;opacity:.6;margin-top:14px;}
  @media(max-width:700px){.phase-news h2{font-size:30px;}}
</style>

<section class="phase-news">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subhead }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="phase-news-form">
        <input type="email" name="contact[email]" placeholder="your@email.com" required>
        <button type="submit">Join</button>
      </div>
      <small>No spam. Unsubscribe anytime.</small>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Phase Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the playbook we wish we'd had." },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Join 40,000+ women getting our weekly note on what's working. Plus 15% off your first order." }
  ],
  "presets": [{ "name": "Phase Newsletter" }]
}
{% endschema %}
