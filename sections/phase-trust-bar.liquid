<style>
  .phase-trust-bar {
    background: var(--cream-dark);
    padding: 40px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .phase-trust-inner {
    display: flex; align-items: center;
    justify-content: space-between;
    gap: 40px; flex-wrap: wrap;
  }
  .phase-trust-label {
    font-size: 11px; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--muted); white-space: nowrap;
  }
  .phase-trust-logos {
    display: flex; gap: 48px; align-items: center; flex-wrap: wrap;
    font-family: 'DM Serif Display', serif;
    font-size: 22px; color: var(--muted); opacity: .7;
  }
  .phase-trust-logos span { font-style: italic; }
</style>

<div class="phase-trust-bar">
  <div class="container">
    <div class="phase-trust-inner">
      <div class="phase-trust-label">As seen in</div>
      <div class="phase-trust-logos">
        <span>Vogue</span>
        <span>Goop</span>
        <span>Well+Good</span>
        <span>The Cut</span>
        <span>mindbodygreen</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Phase Trust Bar",
  "settings": [],
  "presets": [{ "name": "Phase Trust Bar" }]
}
{% endschema %}
