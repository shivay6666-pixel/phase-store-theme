{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}

<div style="max-width:1100px;margin:48px auto;padding:0 24px;">
  <h1 style="font-family:var(--serif);font-size:40px;">Search results</h1>
  <form action="{{ routes.search_url }}" method="get" style="margin:24px 0 32px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" style="width:100%;padding:14px 18px;border:1px solid rgba(44,44,44,0.15);border-radius:999px;font-size:15px;">
  </form>
  {% if search.performed %}
    <p style="color:rgba(44,44,44,0.6);">{{ search.results_count }} results for "{{ search.terms | escape }}"</p>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:24px;">
      {% for item in search.results %}
        <a href="{{ item.url }}" style="color:inherit;text-decoration:none;">
          {% if item.featured_image %}
            <img src="{{ item.featured_image | image_url: width: 400 }}" style="border-radius:12px;width:100%;" alt="{{ item.title | escape }}">
          {% endif %}
          <h3 style="font-family:var(--serif);font-size:18px;margin:8px 0 4px;">{{ item.title }}</h3>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>
