{% comment %} Phase Testimonials Section {% endcomment %}

<style>
  .phase-test{padding:100px 0;background:#5C7A6A;color:#fff;}
  .phase-test .container{max-width:1280px;margin:0 auto;padding:0 24px;}
  .phase-test .head{text-align:center;max-width:700px;margin:0 auto 60px;color:#fff;}
  .phase-test .eyebrow{color:#E8C5B8;font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;margin-bottom:16px;}
  .phase-test h2{font-family:'DM Serif Display',serif;font-size:48px;color:#fff;line-height:1.15;}
  .phase-test-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;}
  .phase-test-card{background:rgba(255,255,255,.08);backdrop-filter:blur(10px);padding:36px 30px;border-radius:6px;border:1px solid rgba(255,255,255,.12);}
  .phase-test-stars{color:#D4A574;font-size:16px;margin-bottom:18px;}
  .phase-test-quote{font-family:'DM Serif Display',serif;font-size:18px;line-height:1.5;margin-bottom:24px;font-style:italic;}
  .phase-test-author{display:flex;align-items:center;gap:14px;}
  .phase-test-author img{width:48px;height:48px;border-radius:50%;object-fit:cover;}
  .phase-test-author .name{font-weight:600;font-size:15px;}
  .phase-test-author .meta{font-size:12px;opacity:.75;}
  @media(max-width:900px){.phase-test-grid{grid-template-columns:1fr;} .phase-test h2{font-size:32px;}}
</style>

<section class="phase-test">
  <div class="container">
    <div class="head">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="phase-test-grid">
      {% for block in section.blocks %}
        <div class="phase-test-card">
          <div class="phase-test-stars">★★★★★</div>
          <p class="phase-test-quote">"{{ block.settings.quote }}"</p>
          <div class="phase-test-author">
            {% if block.settings.avatar != blank %}
              <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.name | escape }}" />
            {% else %}
              <img src="{{ block.settings.fallback_avatar }}" alt="{{ block.settings.name | escape }}" />
            {% endif %}
            <div>
              <div class="name">{{ block.settings.name }}</div>
              <div class="meta">{{ block.settings.meta }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real stories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From women in every phase" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I'd accepted that I'd never sleep through the night again." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "url", "id": "fallback_avatar", "label": "Fallback avatar URL", "default": "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80&auto=format&fit=crop" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sarah K." },
        { "type": "text", "id": "meta", "label": "Meta", "default": "51 · Subscriber 8 months" }
      ]
    }
  ],
  "presets": [
    { "name": "Phase Testimonials", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }
  ]
}
{% endschema %}
