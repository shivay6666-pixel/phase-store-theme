<style>
  .phase-testimonials {
    padding: 100px 0;
    background: var(--sage);
    color: #fff;
  }
  .phase-testimonials .section-head h2,
  .phase-testimonials .section-head p { color: #fff; }
  .phase-testimonials .section-eyebrow { color: var(--blush); }
  .phase-testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .phase-testimonial-card {
    background: rgba(255,255,255,.08);
    backdrop-filter: blur(10px);
    padding: 36px 30px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,.12);
  }
  .phase-testimonial-stars { color: var(--gold); font-size: 16px; margin-bottom: 18px; }
  .phase-testimonial-quote {
    font-family: 'DM Serif Display', serif;
    font-size: 18px; line-height: 1.5;
    margin-bottom: 24px; font-style: italic;
    color: #fff;
  }
  .phase-testimonial-author { display: flex; align-items: center; gap: 14px; }
  .phase-testimonial-author img {
    width: 48px; height: 48px;
    border-radius: 50%; object-fit: cover;
  }
  .phase-testimonial-name { font-weight: 600; font-size: 15px; color: #fff; }
  .phase-testimonial-meta { font-size: 12px; opacity: .75; color: #fff; }
  @media (max-width: 900px) { .phase-testimonial-grid { grid-template-columns: 1fr; } }
</style>

<section class="phase-testimonials">
  <div class="container">
    <div class="section-head">
      <div class="section-eyebrow">Real stories</div>
      <h2>From women in every phase</h2>
    </div>
    <div class="phase-testimonial-grid">
      {% for block in section.blocks %}
        <div class="phase-testimonial-card" {{ block.shopify_attributes }}>
          <div class="phase-testimonial-stars">★★★★★</div>
          <p class="phase-testimonial-quote">"{{ block.settings.quote }}"</p>
          <div class="phase-testimonial-author">
            {% if block.settings.avatar != blank %}
              <img src="{{ block.settings.avatar | image_url: width: 100 }}"
                   alt="{{ block.settings.name }}" loading="lazy" />
            {% else %}
              <img src="{{ block.settings.avatar_url }}"
                   alt="{{ block.settings.name }}" loading="lazy" />
            {% endif %}
            <div>
              <div class="phase-testimonial-name">{{ block.settings.name }}</div>
              <div class="phase-testimonial-meta">{{ block.settings.meta }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Testimonials",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Meta (age, subscriber info)" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar photo" },
        { "type": "text", "id": "avatar_url", "label": "Avatar fallback URL" }
      ]
    }
  ],
  "presets": [{
    "name": "Phase Testimonials",
    "blocks": [
      { "type": "testimonial", "settings": {
        "quote": "I'd accepted I'd never sleep through the night again. Three weeks in, I had to set an alarm because I was sleeping past 7am for the first time in years.",
        "name": "Sarah K.", "meta": "51 · Subscriber 8 months",
        "avatar_url": "https://images.unsplash.com/photo-1545239351-1141bd82e8a6?w=100&q=80&auto=format&fit=crop"
      }},
      { "type": "testimonial", "settings": {
        "quote": "The cooling neck wrap is in my bag at all times. I had a hot flash mid-presentation last week and my colleague didn't even notice. Game changer.",
        "name": "Michelle R.", "meta": "48 · Subscriber 4 months",
        "avatar_url": "https://images.unsplash.com/photo-1573164574396-ce99a23a0d7b?w=100&q=80&auto=format&fit=crop"
      }},
      { "type": "testimonial", "settings": {
        "quote": "Finally a brand that talks to me like an adult. The Daily Balance capsules are part of my morning ritual now and I can feel the difference on the days I forget.",
        "name": "Jennifer L.", "meta": "55 · Subscriber 1 year",
        "avatar_url": "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=100&q=80&auto=format&fit=crop"
      }}
    ]
  }]
}
{% endschema %}
