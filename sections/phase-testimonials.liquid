<style>
  .phase-testimonials {
    padding: 100px 0;
    background: var(--cream-dark);
  }
  .phase-testimonials .section-head { margin-bottom: 56px; }
  .phase-testimonials .section-head h2 { color: var(--charcoal); }

  /* Rating summary */
  .phase-ratings-summary {
    display: flex; align-items: center; justify-content: center;
    gap: 24px; margin-bottom: 56px; flex-wrap: wrap;
  }
  .phase-rating-big {
    text-align: center;
  }
  .phase-rating-big .num {
    font-family: 'DM Serif Display', serif;
    font-size: 64px; line-height: 1; color: var(--terracotta);
  }
  .phase-rating-big .stars { color: var(--gold); font-size: 20px; letter-spacing: 2px; }
  .phase-rating-big .label { font-size: 13px; color: var(--muted); margin-top: 4px; }
  .phase-rating-divider { width: 1px; height: 70px; background: var(--line); }
  .phase-rating-bars { min-width: 200px; }
  .phase-rating-bar-row {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 8px; font-size: 13px; color: var(--muted);
  }
  .phase-rating-bar-row .bar-label { width: 32px; text-align: right; }
  .phase-rating-bar-track {
    flex: 1; height: 6px; background: var(--line);
    border-radius: 3px; overflow: hidden;
  }
  .phase-rating-bar-fill {
    height: 100%; background: var(--gold); border-radius: 3px;
  }
  .phase-rating-bar-row .bar-count { width: 24px; }
  @media (max-width: 560px) {
    .phase-rating-divider { display: none; }
    .phase-rating-bars { width: 100%; }
  }

  /* Filter tabs */
  .phase-review-filters {
    display: flex; gap: 10px; flex-wrap: wrap;
    justify-content: center; margin-bottom: 44px;
  }
  .phase-review-filter {
    padding: 9px 20px; border-radius: 100px;
    border: 1.5px solid var(--line); background: #fff;
    font-size: 13px; font-weight: 500; cursor: pointer;
    transition: all .2s; font-family: 'DM Sans', sans-serif;
    color: var(--muted);
  }
  .phase-review-filter:hover { border-color: var(--terracotta); color: var(--terracotta); }
  .phase-review-filter.active {
    background: var(--terracotta); border-color: var(--terracotta);
    color: #fff;
  }

  /* Review grid */
  .phase-review-grid {
    columns: 3; column-gap: 24px;
  }
  .phase-review-card {
    break-inside: avoid; background: #fff;
    border-radius: 10px; padding: 28px;
    margin-bottom: 24px; border: 1px solid var(--line);
    transition: all .25s;
  }
  .phase-review-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px -12px rgba(60,40,30,.12);
  }
  .phase-review-top {
    display: flex; justify-content: space-between;
    align-items: flex-start; margin-bottom: 16px;
  }
  .phase-review-stars { color: var(--gold); font-size: 14px; letter-spacing: 1px; }
  .phase-review-verified {
    font-size: 10px; font-weight: 600; letter-spacing: 1px;
    text-transform: uppercase; color: var(--sage);
    display: flex; align-items: center; gap: 4px;
  }
  .phase-review-text {
    font-size: 15px; color: var(--charcoal); line-height: 1.7;
    margin-bottom: 20px;
  }
  .phase-review-product {
    font-size: 11px; font-weight: 600; letter-spacing: 1px;
    text-transform: uppercase; color: var(--terracotta);
    margin-bottom: 16px;
  }
  .phase-review-author {
    display: flex; align-items: center; gap: 12px;
  }
  .phase-review-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    object-fit: cover; background: var(--cream);
    flex-shrink: 0;
  }
  .phase-review-name { font-weight: 600; font-size: 14px; color: var(--charcoal); }
  .phase-review-meta { font-size: 12px; color: var(--muted); }

  /* Highlight card */
  .phase-review-card.highlight {
    background: var(--charcoal); border-color: var(--charcoal);
  }
  .phase-review-card.highlight .phase-review-text { color: #fff; }
  .phase-review-card.highlight .phase-review-name { color: #fff; }
  .phase-review-card.highlight .phase-review-meta { color: rgba(255,255,255,.5); }
  .phase-review-card.highlight .phase-review-product { color: var(--gold); }
  .phase-review-card.highlight .phase-review-verified { color: var(--blush); }

  /* Load more */
  .phase-reviews-more {
    text-align: center; margin-top: 50px;
  }
  .phase-reviews-count {
    font-size: 14px; color: var(--muted); margin-bottom: 20px;
  }

  @media (max-width: 1000px) { .phase-review-grid { columns: 2; } }
  @media (max-width: 600px) { .phase-review-grid { columns: 1; } }
</style>

