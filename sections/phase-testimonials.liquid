<script>
function filterReviews(cat, btn) {
  document.querySelectorAll('.phase-review-filter').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('.phase-review-card').forEach(function(card) {
    if (cat === 'all') {
      card.style.display = '';
    } else {
      var cats = (card.getAttribute('data-cat') || '').split(' ');
      card.style.display = cats.indexOf(cat) > -1 ? '' : 'none';
    }
  });
}
</script>

