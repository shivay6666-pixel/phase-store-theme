<script>
(function() {
  var totalSteps = 5;

  function updateProgress(step) {
    var pct = Math.round(((step - 1) / totalSteps) * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressPct').textContent = pct + '%';
    document.getElementById('progressLabel').textContent =
      step <= totalSteps ? ('Question ' + step + ' of ' + totalSteps) : 'Protocol Ready';
  }

  window.phaseSelectOpt = function(el, key) {
    var opts = el.closest('.phase-quiz-options').querySelectorAll('.phase-quiz-opt:not(.multi)');
    opts.forEach(function(o) {
      o.classList.remove('selected');
      o.querySelector('.phase-quiz-opt-check').textContent = '';
    });
    el.classList.add('selected');
    el.querySelector('.phase-quiz-opt-check').textContent = '✓';
    var stepEl = el.closest('.phase-quiz-step');
    if (stepEl) {
      var stepNum = stepEl.id.replace('step', '');
      var nextBtn = document.getElementById('next' + stepNum);
      if (nextBtn) nextBtn.classList.add('enabled');
    }
  };

  window.phaseToggleOpt = function(el) {
    el.classList.toggle('selected');
    el.querySelector('.phase-quiz-opt-check').textContent = el.classList.contains('selected') ? '✓' : '';
  };

  window.phaseNextStep = function(from) {
    var btn = document.getElementById('next' + from);
    if (!btn || !btn.classList.contains('enabled')) return;
    var current = document.getElementById('step' + from);
    var next = document.getElementById('step' + (from + 1));
    if (current) current.classList.remove('active');
    if (next) {
      next.classList.add('active');
      updateProgress(from + 1);
    }
    var hero = document.getElementById('quizHero');
    if (hero) window.scrollTo({ top: hero.offsetTop - 20, behavior: 'smooth' });
  };

  window.phasePrevStep = function(from) {
    var current = document.getElementById('step' + from);
    var prev = document.getElementById('step' + (from - 1));
    if (current) current.classList.remove('active');
    if (prev) {
      prev.classList.add('active');
      updateProgress(from - 1);
    }
    var hero = document.getElementById('quizHero');
    if (hero) window.scrollTo({ top: hero.offsetTop - 20, behavior: 'smooth' });
  };

  window.phaseShowResults = function() {
    var btn = document.getElementById('next5');
    if (!btn || !btn.classList.contains('enabled')) return;
    document.getElementById('step5').classList.remove('active');
    document.getElementById('quizResults').classList.add('active');
    document.getElementById('progressFill').style.width = '100%';
    document.getElementById('progressPct').textContent = '100%';
    document.getElementById('progressLabel').textContent = 'Protocol Ready';
    var hero = document.getElementById('quizHero');
    if (hero) window.scrollTo({ top: hero.offsetTop - 20, behavior: 'smooth' });
  };

  updateProgress(1);
})();
</script>

