<div id="phase-quiz-root"></div>

<style>
  .phase-quiz-wrapper {
    background: var(--cream);
    min-height: 70vh;
    padding: 60px 0 100px;
  }
  #phase-quiz-root * { box-sizing: border-box; margin: 0; padding: 0; }
  #phase-quiz-root { font-family: 'DM Sans', sans-serif; }
  .pq-wrap { max-width: 680px; margin: 0 auto; padding: 0 24px; }
  .pq-header { text-align: center; margin-bottom: 48px; }
  .pq-eyebrow { font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--terracotta); margin-bottom: 14px; }
  .pq-header h1 { font-family: 'DM Serif Display', serif; font-size: clamp(32px, 5vw, 50px); color: var(--charcoal); line-height: 1.15; margin-bottom: 16px; }
  .pq-header p { font-size: 17px; color: var(--muted); line-height: 1.65; }
  .pq-progress-bar { width: 100%; height: 3px; background: var(--line); border-radius: 2px; margin-bottom: 40px; overflow: hidden; }
  .pq-progress-fill { height: 100%; background: var(--terracotta); transition: width 0.4s ease; border-radius: 2px; }
  .pq-step { display: none; }
  .pq-step.active { display: block; animation: pqIn .35s ease; }
  @keyframes pqIn { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
  .pq-question { font-family: 'DM Serif Display', serif; font-size: clamp(22px, 3.5vw, 30px); color: var(--charcoal); margin-bottom: 8px; line-height: 1.3; }
  .pq-subtext { font-size: 14px; color: var(--muted); margin-bottom: 32px; line-height: 1.5; }
  .pq-options { display: grid; gap: 12px; }
  .pq-options.multi { grid-template-columns: 1fr 1fr; }
  @media (max-width: 520px) { .pq-options.multi { grid-template-columns: 1fr; } }
  .pq-opt { display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: 6px; border: 1.5px solid var(--line); background: #fff; cursor: pointer; transition: all .2s; font-size: 15px; font-weight: 500; color: var(--charcoal); text-align: left; user-select: none; }
  .pq-opt:hover { border-color: var(--terracotta); background: #FDF8F4; }
  .pq-opt.sel { border-color: var(--terracotta); background: #FDF4EE; color: var(--terracotta); }
  .pq-opt-icon { font-size: 22px; flex-shrink: 0; line-height: 1; }
  .pq-opt-label { flex: 1; line-height: 1.4; }
  .pq-opt-check { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--line); flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .2s; font-size: 11px; color: #fff; }
  .pq-opt.sel .pq-opt-check { background: var(--terracotta); border-color: var(--terracotta); }
  .pq-nav { display: flex; gap: 12px; margin-top: 32px; align-items: center; }
  .pq-next { flex: 1; padding: 18px 32px; background: var(--terracotta); color: #fff; border: none; border-radius: 3px; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; transition: all .25s; }
  .pq-next:hover:not(:disabled) { background: var(--terracotta-dark); transform: translateY(-1px); }
  .pq-next:disabled { background: #D4C5B8; cursor: not-allowed; }
  .pq-back { padding: 18px 20px; background: transparent; border: 1.5px solid var(--line); border-radius: 3px; font-size: 13px; font-weight: 500; color: var(--muted); cursor: pointer; transition: all .2s; font-family: 'DM Sans', sans-serif; }
  .pq-back:hover { border-color: var(--charcoal); color: var(--charcoal); }
  .pq-count { font-size: 12px; color: #9B9B9B; }
  /* Results */
  .pq-results { display: none; }
  .pq-results.active { display: block; animation: pqIn .4s ease; }
  .pq-results-hd { text-align: center; margin-bottom: 48px; }
  .pq-results-hd h2 { font-family: 'DM Serif Display', serif; font-size: clamp(28px, 4.5vw, 44px); color: var(--charcoal); margin-bottom: 12px; line-height: 1.2; }
  .pq-results-hd p { font-size: 16px; color: var(--muted); }
  .pq-rec-grid { display: grid; gap: 20px; }
  .pq-rec { display: flex; gap: 20px; padding: 24px; background: #fff; border-radius: 8px; border: 1px solid var(--line); align-items: flex-start; text-decoration: none; color: inherit; transition: all .25s; }
  .pq-rec:hover { transform: translateY(-3px); box-shadow: 0 16px 40px -12px rgba(60,40,30,.15); border-color: var(--terracotta); }
  .pq-rec-img { width: 90px; height: 90px; object-fit: contain; border-radius: 6px; background: var(--cream); flex-shrink: 0; }
  .pq-rec-body { flex: 1; }
  .pq-rec-badge { display: inline-block; padding: 4px 10px; background: #EAF2EE; color: var(--sage); font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; border-radius: 2px; margin-bottom: 8px; }
  .pq-rec-title { font-family: 'DM Serif Display', serif; font-size: 18px; color: var(--charcoal); margin-bottom: 6px; line-height: 1.3; }
  .pq-rec-desc { font-size: 13px; color: var(--muted); line-height: 1.55; margin-bottom: 12px; }
  .pq-rec-foot { display: flex; align-items: center; gap: 12px; }
  .pq-rec-price { font-size: 15px; font-weight: 600; color: var(--charcoal); }
  .pq-rec-cta { font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--terracotta); text-decoration: underline; text-underline-offset: 3px; }
  .pq-email-box { background: var(--sage); color: #fff; border-radius: 8px; padding: 32px; text-align: center; margin-top: 32px; }
  .pq-email-box h3 { font-family: 'DM Serif Display', serif; font-size: 22px; margin-bottom: 10px; }
  .pq-email-box p { font-size: 14px; opacity: .85; margin-bottom: 20px; }
  .pq-email-row { display: flex; gap: 10px; max-width: 420px; margin: 0 auto; }
  .pq-email-in { flex: 1; padding: 14px 16px; border-radius: 3px; border: none; font-size: 14px; font-family: 'DM Sans', sans-serif; }
  .pq-email-btn { padding: 14px 20px; background: var(--terracotta); color: #fff; border: none; border-radius: 3px; cursor: pointer; font-size: 12px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; font-family: 'DM Sans', sans-serif; transition: background .2s; }
  .pq-email-btn:hover { background: var(--terracotta-dark); }
  .pq-restart-link { display: block; text-align: center; margin-top: 40px; font-size: 13px; color: #9B9B9B; text-decoration: underline; cursor: pointer; text-underline-offset: 3px; }
  .pq-restart-link:hover { color: var(--charcoal); }
  @media (max-width: 480px) { .pq-email-row { flex-direction: column; } }
</style>

<section class="phase-quiz-wrapper">
  <div id="phase-quiz-root"></div>
</section>

<script>
(function() {
  var P = {
    thermella:  { t:"Thermella® by Bonafide",   price:"$60",     img:"https://hellobonafide.com/cdn/shop/files/Bonafide_THERMELLA-PARENT_Shopify_Thumb1Hero.png?v=1756816689",               d:"Hormone-free hot flash relief targeting NKB — the peptide behind temperature dysregulation.",              url:"/products/thermella-by-bonafide",                badge:"Top Pick · Hot Flashes" },
    relizen:    { t:"Relizen® by Bonafide",      price:"$58",     img:"https://hellobonafide.com/cdn/shop/files/Bonafide_RELIZEN-PARENT_Shopify_Thumb1Hero.png?v=1759868901&width=600",        d:"Swedish pollen extract — 75% of women experienced reduced hot flash frequency.",                           url:"/products/relizen-by-bonafide",                  badge:"Bestseller · Hot Flashes" },
    noctera:    { t:"Noctera™ by Bonafide",      price:"$39.99",  img:"https://hellobonafide.com/cdn/shop/files/Bonafide_NOCTERA-PARENT_Shopify_Thumb1Hero.png?v=1766535772",                 d:"Non-sedative sleep formula for hormonal insomnia — 99% fewer sleep disturbances.",                        url:"/products/noctera-by-bonafide",                  badge:"Top Pick · Sleep" },
    hilma_sl:   { t:"Sleep Support by Hilma",    price:"$42",     img:"https://www.hilma.co/cdn/shop/files/2047_HUMAN_157B_HILMA_Hilma_november6875.jpg",                                     d:"Magnesium glycinate + passionflower + lemon balm. No grogginess. No dependency.",                         url:"/products/sleep-support-by-hilma",               badge:"Editor Pick · Sleep" },
    serenol:    { t:"Serenol™ by Bonafide",      price:"$63",     img:"https://hellobonafide.com/cdn/shop/files/Bonafide_SERENOL-PARENT_Shopify_Thumb1Hero.png?v=1759868545&width=600",       d:"71% reduction in mood swings. 70% reduction in irritability. Clinically tested.",                         url:"/products/serenol-by-bonafide",                  badge:"Clinically Studied · Mood" },
    tension:    { t:"Tension Relief by Hilma",   price:"$32",     img:"https://www.hilma.co/cdn/shop/files/2047_HUMAN_179C_HILMA_Hilma_november6909.jpg",                                     d:"White willow bark + butterbur + magnesium for head tension and mental fog.",                               url:"/products/tension-relief-by-hilma",              badge:"Focus & Clarity" },
    revaree:    { t:"Revaree® by Bonafide",      price:"$63",     img:"https://hellobonafide.com/cdn/shop/files/Bonafide_REVAREE-PARENT_Shopify_Thumb3Summary.png?v=1756815894",              d:"#1 OB/GYN-recommended hormone-free vaginal insert. Relief in as little as 9 days.",                        url:"/products/revaree-by-bonafide",                  badge:"OB/GYN Recommended" },
    clairvee:   { t:"Clairvee® by Bonafide",     price:"$55",     img:"https://hellobonafide.com/cdn/shop/files/Clairvee_Desktop.png?v=1731511710&width=600",                                 d:"Vaginal probiotic — 95% of women reduced moderate-to-severe vaginal odor in one month.",                  url:"/products/clairvee-by-bonafide",                 badge:"Intimate Health" },
    ristela:    { t:"Ristela® by Bonafide",      price:"$58",     img:"https://hellobonafide.com/cdn/shop/files/Bonafide_RISTELA-PARENT_Shopify_HowItWorks.jpg?v=1727298917&width=600",       d:"75% increase in arousal and satisfaction at 8 weeks. Plant-based, hormone-free.",                          url:"/products/ristela-by-bonafide",                  badge:"Sexual Wellness" },
    silvessa:   { t:"Silvessa® System by Bonafide", price:"$126", img:"https://hellobonafide.com/cdn/shop/files/Bonafide_SILKIT30DAYSTOCKB_Shopify_Thumb1Hero.png?v=1756842728",              d:"The only 3-part system (oral capsule + 2 serums) for estrogen-related hair and skin decline.",             url:"/products/silvessa-hair-skin-system-by-bonafide",badge:"Skin & Hair" },
    menorelief: { t:"MenoRelief™ by Kindra",     price:"$44",     img:"https://ourkindra.com/cdn/shop/files/MenoRelief_PDP_Hero_Desktop_1.jpg?v=1747175558&width=600",                       d:"One capsule targets 11 symptoms. Built around Pycnogenol® — studied in 40+ clinical trials.",             url:"/products/menorelief-by-kindra",                 badge:"Comprehensive Relief" },
    multi:      { t:"Women's 40+ Multi by Bonafide", price:"$18", img:"https://hellobonafide.com/cdn/shop/files/Bonafide_MULTIVITAMIN-PARENT_Shopify_Thumb1Hero.png?v=1759868535&width=600", d:"15 vitamins and minerals formulated for women over 40. No iron, no fillers.",                              url:"/products/womens-40-multi-by-bonafide",          badge:"Daily Foundation" },
    bundle:     { t:"Sleep + Hot Flash Bundle",  price:"$84.99",  img:"https://hellobonafide.com/cdn/shop/files/Bonafide_BNDLNOCRIS_Shopify_PLP.png?v=1766087043&width=600",                 d:"Noctera™ + Thermella® together — the two most-ordered Phase products at 15% off.",                        url:"/products/sleep-hot-flash-bundle-by-bonafide",   badge:"Bundle · Save 15%" }
  };

  var QS = [
    { id:"q1", q:"How long have you been experiencing symptoms?", sub:"Helps us understand your phase.", type:"single", opts:[
      {i:"🌱",l:"Just starting — a few months",v:"new"},
      {i:"📅",l:"6 months to 2 years",v:"mid"},
      {i:"🌊",l:"2–5 years",v:"established"},
      {i:"🌸",l:"5+ years (postmenopause)",v:"post"}
    ]},
    { id:"q2", q:"Which symptoms bother you most?", sub:"Select all that apply — we'll match a product to each one.", type:"multi", opts:[
      {i:"🔥",l:"Hot flashes or night sweats",v:"hf"},
      {i:"😴",l:"Can't fall or stay asleep",v:"sl"},
      {i:"😤",l:"Mood swings or irritability",v:"mo"},
      {i:"🧠",l:"Brain fog or poor focus",v:"fo"},
      {i:"💧",l:"Vaginal dryness or discomfort",v:"vd"},
      {i:"❤️",l:"Low libido or reduced arousal",v:"li"},
      {i:"💇",l:"Hair thinning or skin changes",v:"ha"},
      {i:"🌡️",l:"Bloating or gut changes",v:"gu"}
    ]},
    { id:"q3", q:"How severely do your symptoms affect daily life?", sub:"Be honest — this shapes your protocol.", type:"single", opts:[
      {i:"😌",l:"Mild — I notice them but cope fine",v:"mild"},
      {i:"😐",l:"Moderate — they interrupt my day",v:"mod"},
      {i:"😩",l:"Significant — I want them gone",v:"sev"},
      {i:"🚨",l:"Severe — affecting work, sleep, relationships",v:"crit"}
    ]},
    { id:"q4", q:"Are you currently using hormone therapy (HRT)?", sub:"All Phase products are hormone-free and safe with HRT.", type:"single", opts:[
      {i:"✅",l:"Yes — currently on HRT",v:"yes"},
      {i:"🤔",l:"Considering it but not yet",v:"con"},
      {i:"🌿",l:"No — prefer hormone-free options",v:"no"},
      {i:"⚕️",l:"Can't use hormones (medical reason)",v:"cant"}
    ]},
    { id:"q5", q:"What matters most to you in a product?", sub:"We'll prioritize your top value.", type:"single", opts:[
      {i:"🔬",l:"Clinical studies and proven results",v:"clin"},
      {i:"🌿",l:"Natural, plant-based ingredients",v:"nat"},
      {i:"💊",l:"Simple — one product that does it all",v:"simp"},
      {i:"💰",l:"Best value for the money",v:"val"}
    ]}
  ];

  var ANS = {}, STEP = 0;

  function recs() {
    var s = ANS.q2||[], r=[];
    if(s.indexOf("hf")>-1){r.push("thermella");r.push("relizen");}
    if(s.indexOf("sl")>-1){r.push("noctera");r.push("hilma_sl");}
    if(s.indexOf("mo")>-1) r.push("serenol");
    if(s.indexOf("fo")>-1) r.push("tension");
    if(s.indexOf("vd")>-1) r.push("revaree");
    if(s.indexOf("li")>-1) r.push("ristela");
    if(s.indexOf("ha")>-1) r.push("silvessa");
    if(s.indexOf("gu")>-1) r.push("menorelief");
    if(ANS.q5==="simp") r.unshift("menorelief");
    if(ANS.q5==="val") r.push("multi");
    if(s.indexOf("hf")>-1&&s.indexOf("sl")>-1) r.push("bundle");
    if(r.length===0) r=["menorelief","noctera","thermella","multi"];
    var seen={},out=[];
    for(var i=0;i<r.length;i++){if(!seen[r[i]]){seen[r[i]]=true;out.push(r[i]);}}
    if(out.length<3&&out.indexOf("multi")<0) out.push("multi");
    return out.slice(0,4);
  }

  function draw(){
    var root=document.getElementById("phase-quiz-root");
    if(!root) return;
    if(STEP>=QS.length){results(root);return;}
    var q=QS[STEP], isM=q.type==="multi";
    var sel=ANS[q.id]||(isM?[]:null);
    var ok=isM?sel.length>0:sel!==null;
    var pct=(STEP/QS.length*100).toFixed(0);

    root.innerHTML=
      '<div class="pq-wrap">'+
        '<div class="pq-header">'+
          '<div class="pq-eyebrow">Your Personalized Protocol</div>'+
          '<h1>Find your <em style="font-style:italic;color:var(--terracotta)">relief.</em></h1>'+
          '<p>5 quick questions — personalized picks in under 60 seconds.</p>'+
        '</div>'+
        '<div class="pq-progress-bar"><div class="pq-progress-fill" style="width:'+pct+'%"></div></div>'+
        '<div class="pq-step active">'+
          '<div class="pq-question">'+q.q+'</div>'+
          '<div class="pq-subtext">'+q.sub+'</div>'+
          '<div class="pq-options'+(isM?' multi':'')+'">'+ q.opts.map(function(o){
            var s=isM?sel.indexOf(o.v)>-1:sel===o.v;
            return '<div class="pq-opt'+(s?' sel':'')+'" data-v="'+o.v+'">'+
              '<span class="pq-opt-icon">'+o.i+'</span>'+
              '<span class="pq-opt-label">'+o.l+'</span>'+
              '<span class="pq-opt-check">'+(s?'&#10003;':'')+'</span>'+
            '</div>';
          }).join('')+'</div>'+
          '<div class="pq-nav">'+
            (STEP>0?'<button class="pq-back" id="pqb">← Back</button>':'')+
            '<button class="pq-next" id="pqn"'+(ok?'':' disabled')+'>Continue →</button>'+
            '<span class="pq-count">'+(STEP+1)+' / '+QS.length+'</span>'+
          '</div>'+
        '</div>'+
      '</div>';

    root.querySelectorAll(".pq-opt").forEach(function(el){
      el.addEventListener("click",function(){
        var v=this.getAttribute("data-v");
        if(isM){var a=ANS[q.id]||[];var i=a.indexOf(v);if(i>-1)a.splice(i,1);else a.push(v);ANS[q.id]=a;}
        else ANS[q.id]=v;
        draw();
      });
    });
    var n=root.querySelector("#pqn"); if(n) n.addEventListener("click",function(){if(!this.disabled){STEP++;draw();}});
    var b=root.querySelector("#pqb"); if(b) b.addEventListener("click",function(){STEP--;draw();});
  }

  function results(root){
    var r=recs();
    root.innerHTML=
      '<div class="pq-wrap">'+
        '<div class="pq-results active">'+
          '<div class="pq-results-hd">'+
            '<div class="pq-eyebrow">Your Personalized Protocol</div>'+
            '<h2>Your picks are ready.</h2>'+
            '<p>Based on your symptoms and priorities — here is where to start.</p>'+
          '</div>'+
          '<div class="pq-rec-grid">'+r.map(function(k){
            var p=P[k]; if(!p) return '';
            return '<a href="'+p.url+'" class="pq-rec">'+
              '<img class="pq-rec-img" src="'+p.img+'" alt="'+p.t+'" loading="lazy"/>'+
              '<div class="pq-rec-body">'+
                '<div class="pq-rec-badge">'+p.badge+'</div>'+
                '<div class="pq-rec-title">'+p.t+'</div>'+
                '<div class="pq-rec-desc">'+p.d+'</div>'+
                '<div class="pq-rec-foot">'+
                  '<span class="pq-rec-price">'+p.price+'</span>'+
                  '<span class="pq-rec-cta">View product →</span>'+
                '</div>'+
              '</div>'+
            '</a>';
          }).join('')+'</div>'+
          '<div class="pq-email-box">'+
            '<h3>Get your protocol by email.</h3>'+
            '<p>We\'ll send your picks + a 15% first-order code straight to your inbox.</p>'+
            '<div class="pq-email-row">'+
              '<input class="pq-email-in" type="email" placeholder="your@email.com"/>'+
              '<button class="pq-email-btn" onclick="this.textContent=\'Sent ✓\'">Send my picks</button>'+
            '</div>'+
          '</div>'+
          '<span class="pq-restart-link" onclick="location.reload()">← Retake the quiz</span>'+
        '</div>'+
      '</div>';
  }

  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",draw);
  else draw();
})();
</script>

{% schema %}
{
  "name": "Phase Quiz Page",
  "settings": [],
  "presets": [{ "name": "Phase Quiz Page" }]
}
{% endschema %}
