<style>
  /* ===== QUIZ PAGE ===== */
  .phase-quiz-page { background: var(--cream); min-height: 100vh; }

  /* Hero banner */
  .phase-quiz-hero {
    background: linear-gradient(160deg, var(--charcoal) 0%, #3d2a22 100%);
    padding: 72px 0 60px;
    text-align: center;
    color: #fff;
  }
  .phase-quiz-hero-eyebrow {
    font-size: 11px; font-weight: 600; letter-spacing: 3px;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 16px;
  }
  .phase-quiz-hero h1 {
    font-size: clamp(30px, 4vw, 48px);
    color: #fff; line-height: 1.15; margin-bottom: 16px;
  }
  .phase-quiz-hero h1 em { font-style: italic; color: var(--blush); }
  .phase-quiz-hero-sub {
    font-size: 17px; opacity: .8; max-width: 520px;
    margin: 0 auto; line-height: 1.6;
  }
  .phase-quiz-progress-wrap {
    margin-top: 40px; max-width: 420px; margin-left: auto; margin-right: auto;
  }
  .phase-quiz-progress-label {
    display: flex; justify-content: space-between;
    font-size: 12px; opacity: .6; margin-bottom: 10px;
    font-weight: 500; letter-spacing: .5px;
  }
  .phase-quiz-progress-bar {
    height: 4px; background: rgba(255,255,255,.15);
    border-radius: 2px; overflow: hidden;
  }
  .phase-quiz-progress-fill {
    height: 100%; background: var(--gold);
    border-radius: 2px;
    transition: width .5s cubic-bezier(.4,0,.2,1);
  }

  /* Quiz body */
  .phase-quiz-body { padding: 60px 0 100px; }
  .phase-quiz-container { max-width: 680px; margin: 0 auto; }

  /* Step */
  .phase-quiz-step { display: none; }
  .phase-quiz-step.active { display: block; animation: stepIn .35s ease; }
  @keyframes stepIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .phase-quiz-step-num {
    font-size: 11px; font-weight: 700; letter-spacing: 3px;
    text-transform: uppercase; color: var(--terracotta); margin-bottom: 10px;
  }
  .phase-quiz-step h2 {
    font-size: clamp(24px, 3.5vw, 36px);
    line-height: 1.2; margin-bottom: 10px; color: var(--charcoal);
  }
  .phase-quiz-step-sub {
    font-size: 15px; color: var(--muted); margin-bottom: 36px;
  }

  /* Options grid */
  .phase-quiz-options {
    display: grid; gap: 14px;
    grid-template-columns: 1fr;
  }
  .phase-quiz-options.two-col { grid-template-columns: 1fr 1fr; }
  @media (max-width: 560px) {
    .phase-quiz-options.two-col { grid-template-columns: 1fr; }
  }

  .phase-quiz-opt {
    display: flex; align-items: flex-start; gap: 16px;
    padding: 20px 22px; background: #fff;
    border: 1.5px solid var(--line); border-radius: 8px;
    cursor: pointer; transition: all .2s; text-align: left;
    position: relative; user-select: none;
  }
  .phase-quiz-opt:hover {
    border-color: var(--terracotta); background: #fff9f6;
    transform: translateY(-1px); box-shadow: 0 4px 16px rgba(201,123,92,.1);
  }
  .phase-quiz-opt.selected {
    border-color: var(--terracotta); background: #fff3ee;
    box-shadow: 0 0 0 3px rgba(201,123,92,.12);
  }
  .phase-quiz-opt-check {
    width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid var(--line); flex-shrink: 0;
    margin-top: 1px; display: flex; align-items: center; justify-content: center;
    transition: all .2s; font-size: 12px;
  }
  .phase-quiz-opt.selected .phase-quiz-opt-check {
    background: var(--terracotta); border-color: var(--terracotta);
    color: #fff;
  }
  .phase-quiz-opt-icon { font-size: 28px; flex-shrink: 0; }
  .phase-quiz-opt-title {
    font-weight: 600; font-size: 15px;
    color: var(--charcoal); margin-bottom: 3px; display: block;
  }
  .phase-quiz-opt-desc { font-size: 13px; color: var(--muted); line-height: 1.5; display: block; }

  /* Navigation */
  .phase-quiz-nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 36px;
  }
  .phase-quiz-back {
    font-size: 14px; font-weight: 500; color: var(--muted);
    cursor: pointer; background: none; border: none;
    display: flex; align-items: center; gap: 6px;
    transition: color .2s; padding: 0; font-family: 'DM Sans', sans-serif;
  }
  .phase-quiz-back:hover { color: var(--charcoal); }
  .phase-quiz-next {
    padding: 16px 36px; background: var(--terracotta); color: #fff;
    border: none; border-radius: 4px; font-size: 13px; font-weight: 600;
    letter-spacing: 1px; text-transform: uppercase; cursor: pointer;
    transition: all .25s; display: flex; align-items: center; gap: 8px;
    font-family: 'DM Sans', sans-serif;
    opacity: .35; pointer-events: none;
  }
  .phase-quiz-next.enabled {
    opacity: 1; pointer-events: auto;
  }
  .phase-quiz-next.enabled:hover {
    background: var(--terracotta-dark); transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(201,123,92,.3);
  }

  /* Results */
  .phase-quiz-results { display: none; }
  .phase-quiz-results.active { display: block; animation: stepIn .4s ease; }

  .phase-quiz-results-header {
    text-align: center; padding: 20px 0 40px;
  }
  .phase-quiz-results-eyebrow {
    font-size: 11px; font-weight: 600; letter-spacing: 3px;
    text-transform: uppercase; color: var(--terracotta); margin-bottom: 14px;
  }
  .phase-quiz-results-header h2 {
    font-size: clamp(28px, 4vw, 44px); margin-bottom: 12px;
  }
  .phase-quiz-results-header p { font-size: 17px; color: var(--muted); max-width: 520px; margin: 0 auto; }

  .phase-quiz-protocol {
    background: var(--charcoal); border-radius: 12px;
    padding: 48px; margin-bottom: 40px; color: #fff;
  }
  .phase-quiz-protocol-label {
    font-size: 11px; font-weight: 600; letter-spacing: 3px;
    text-transform: uppercase; color: var(--gold); margin-bottom: 12px;
  }
  .phase-quiz-protocol h3 {
    font-size: 28px; color: #fff; margin-bottom: 16px;
  }
  .phase-quiz-protocol > p { font-size: 16px; opacity: .8; line-height: 1.7; margin-bottom: 24px; }
  .phase-quiz-protocol-products {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    margin-top: 28px;
  }
  .phase-quiz-protocol-product {
    background: rgba(255,255,255,.07); border-radius: 8px;
    padding: 20px; border: 1px solid rgba(255,255,255,.1);
  }
  .phase-quiz-protocol-product h4 {
    font-size: 15px; color: #fff; margin-bottom: 6px;
    font-family: 'DM Sans', sans-serif; font-weight: 600;
  }
  .phase-quiz-protocol-product p { font-size: 12px; opacity: .6; margin: 0; line-height: 1.5; }
  .phase-quiz-protocol-product .price {
    font-size: 16px; color: var(--gold); font-weight: 600;
    margin-top: 10px; margin-bottom: 0; opacity: 1;
  }
  @media (max-width: 600px) {
    .phase-quiz-protocol-products { grid-template-columns: 1fr; }
    .phase-quiz-protocol { padding: 32px 24px; }
  }

  .phase-quiz-results-cta {
    text-align: center; padding: 40px 0 20px;
  }
  .phase-quiz-results-cta h3 { font-size: 26px; margin-bottom: 10px; }
  .phase-quiz-results-cta p { font-size: 16px; color: var(--muted); margin-bottom: 28px; }
  .phase-quiz-results-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  /* Guarantee strip */
  .phase-quiz-guarantee {
    background: var(--cream-dark); border-top: 1px solid var(--line);
    padding: 32px 0; text-align: center; margin-top: 60px;
  }
  .phase-quiz-guarantee p {
    font-size: 14px; color: var(--muted); max-width: 520px; margin: 0 auto;
  }
  .phase-quiz-guarantee strong { color: var(--charcoal); }
</style>

