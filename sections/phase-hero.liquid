<style>
  .phase-hero {
    padding: 60px 0 80px;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-dark) 100%);
  }
  .phase-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .phase-hero-eyebrow {
    color: var(--terracotta);
    font-size: 13px; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase;
    margin-bottom: 20px;
  }
  .phase-hero h1 {
    font-size: 64px;
    margin-bottom: 24px;
    letter-spacing: -1px;
  }
  .phase-hero h1 em { font-style: italic; color: var(--terracotta); }
  .phase-hero-sub {
    font-size: 18px;
    color: var(--muted);
    margin-bottom: 36px;
    max-width: 520px;
    line-height: 1.6;
  }
  .phase-hero-cta { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }
  .phase-hero-image { position: relative; }
  .phase-hero-image img {
    border-radius: 4px;
    width: 100%; height: 600px;
    object-fit: cover;
    object-position: center top;
    box-shadow: 0 30px 60px -20px rgba(60,40,30,.25);
  }
  .phase-hero-badge {
    position: absolute; bottom: -30px; left: -30px;
    background: #fff;
    padding: 24px 28px;
    border-radius: 4px;
    box-shadow: 0 20px 40px -10px rgba(60,40,30,.2);
    max-width: 280px;
  }
  .phase-hero-badge .stars { color: var(--gold); font-size: 16px; margin-bottom: 6px; }
  .phase-hero-badge p { font-size: 13px; color: var(--muted); margin: 0; line-height: 1.5; }
  .phase-hero-badge strong { color: var(--charcoal); display: block; font-size: 14px; margin-top: 8px; }
  @media (max-width: 900px) {
    .phase-hero h1 { font-size: 42px; }
    .phase-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .phase-hero-image img { height: 420px; }
    .phase-hero-badge { position: static; margin-top: 20px; }
  }
</style>

<section class="phase-hero">
  <div class="container">
    <div class="phase-hero-grid">
      <div>
        <div class="phase-hero-eyebrow">{{ section.settings.eyebrow }}</div>
        <h1>{{ section.settings.headline_line1 }}<br><em>{{ section.settings.headline_line2 }}</em></h1>
        <p class="phase-hero-sub">{{ section.settings.subhead }}</p>
        <div class="phase-hero-cta">
          <a href="{{ section.settings.cta_link }}" class="btn btn-primary">{{ section.settings.cta_text }} &rarr;</a>
          <a href="{{ section.settings.cta2_link }}" class="btn btn-ghost">{{ section.settings.cta2_text }}</a>
        </div>
      </div>
      <div class="phase-hero-image">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 900 }}"
               alt="{{ section.settings.image.alt | escape }}" loading="eager" />
        {% else %}
          <img src="https://images.unsplash.com/photo-1607746882042-944635dfe10e?w=900&q=85&auto=format&fit=crop&crop=top"
               alt="Woman in calm wellness moment" loading="eager" />
        {% endif %}
        <div class="phase-hero-badge">
          <div class="stars">★★★★★</div>
          <p>"For the first time in two years, I slept seven hours straight."</p>
          <strong>— Linda, 53</strong>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phase Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For the women who weren't warned" },
    { "type": "text", "id": "headline_line1", "label": "Headline line 1", "default": "Symptoms have a season." },
    { "type": "text", "id": "headline_line2", "label": "Headline line 2 (italic)", "default": "So does relief." },
    { "type": "textarea", "id": "subhead", "label": "Subheadline", "default": "Doctor-formulated, plant-powered support for hot flashes, sleepless nights, and the moments you don't recognize yourself. Designed for the phase you're in." },
    { "type": "text", "id": "cta_text", "label": "Primary CTA", "default": "Shop Relief" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA", "default": "Take the 60-second quiz" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Phase Hero" }]
}
{% endschema %}
