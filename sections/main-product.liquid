<style>
/* ===================================================
   PHASE PRODUCT PAGE — full PDP
   =================================================== */

  .phase-product-page { background: var(--cream); }

  /* Breadcrumb */
  .phase-breadcrumb {
    padding: 14px 0;
    font-size: 12px; color: var(--muted);
    border-bottom: 1px solid var(--line);
    letter-spacing: .3px;
  }
  .phase-breadcrumb a { color: var(--muted); transition: color .2s; }
  .phase-breadcrumb a:hover { color: var(--terracotta); }
  .phase-breadcrumb .sep { margin: 0 8px; opacity: .4; }

  /* ── Product main layout ─────────────────────────── */
  .phase-product-main { padding: 48px 0 80px; }
  .phase-product-layout {
    display: grid;
    grid-template-columns: 52% 1fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .phase-product-layout { grid-template-columns: 1fr; gap: 36px; }
  }

  /* ── Gallery ─────────────────────────────────────── */
  .phase-gallery { position: sticky; top: 88px; }

  .phase-gallery-main {
    position: relative;
    border-radius: 6px; overflow: hidden;
    background: var(--cream-dark);
    aspect-ratio: 1 / 1;
    margin-bottom: 10px;
    cursor: zoom-in;
  }
  .phase-gallery-main img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .4s ease, opacity .25s;
    display: block;
  }
  .phase-gallery-main:hover img { transform: scale(1.04); }

  .phase-gallery-badge {
    position: absolute; top: 14px; left: 14px;
    background: var(--terracotta); color: #fff;
    font-size: 10px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    padding: 5px 11px; border-radius: 2px;
    pointer-events: none;
  }
  .phase-gallery-badge-green {
    position: absolute; top: 14px; right: 14px;
    background: var(--sage); color: #fff;
    font-size: 10px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    padding: 5px 11px; border-radius: 2px;
    pointer-events: none;
  }

  .phase-gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .phase-thumb {
    aspect-ratio: 1/1; border-radius: 4px;
    overflow: hidden; cursor: pointer;
    border: 2px solid transparent;
    transition: border-color .2s, opacity .2s;
    background: var(--cream-dark);
  }
  .phase-thumb.active  { border-color: var(--terracotta); }
  .phase-thumb:hover   { opacity: .85; }
  .phase-thumb img     { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ── Product info column ─────────────────────────── */
  .phase-product-vendor {
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--terracotta); margin-bottom: 10px;
  }
  .phase-product-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.15; margin-bottom: 14px;
    color: var(--charcoal);
  }

  /* Star rating row */
  .phase-rating-row {
    display: flex; align-items: center;
    gap: 10px; margin-bottom: 18px; flex-wrap: wrap;
  }
  .phase-stars-gold { color: #E8A838; font-size: 15px; letter-spacing: 1px; }
  .phase-rating-score { font-size: 14px; font-weight: 700; color: var(--charcoal); }
  .phase-rating-link {
    font-size: 13px; color: var(--muted);
    text-decoration: underline; text-underline-offset: 3px;
    cursor: pointer; background: none; border: none;
    font-family: inherit; padding: 0;
  }
  .phase-verified-pill {
    font-size: 11px; font-weight: 600; letter-spacing: .5px;
    color: var(--sage); background: rgba(92,122,106,.1);
    padding: 4px 10px; border-radius: 20px;
  }

  /* Price */
  .phase-price-row {
    display: flex; align-items: baseline;
    gap: 10px; margin-bottom: 20px; flex-wrap: wrap;
  }
  .phase-price {
    font-family: 'DM Serif Display', serif;
    font-size: 34px; color: var(--charcoal);
    line-height: 1;
  }
  .phase-compare { font-size: 18px; color: var(--muted); text-decoration: line-through; }
  .phase-save-pill {
    font-size: 12px; font-weight: 700;
    color: #fff; background: var(--sage);
    padding: 4px 10px; border-radius: 2px;
  }

  /* Subscribe toggle */
  .phase-sub-toggle {
    display: flex;
    border: 1.5px solid var(--line);
    border-radius: 6px; overflow: hidden;
    margin-bottom: 20px;
  }
  .phase-sub-btn {
    flex: 1; padding: 13px 14px;
    background: #fff; border: none;
    text-align: left; cursor: pointer;
    font-family: inherit; transition: background .2s;
  }
  .phase-sub-btn.active { background: var(--cream-dark); }
  .phase-sub-btn-label {
    display: block; font-size: 13px;
    font-weight: 600; color: var(--charcoal); margin-bottom: 2px;
  }
  .phase-sub-btn-note { display: block; font-size: 11px; color: var(--muted); }
  .phase-sub-divider { width: 1.5px; background: var(--line); flex-shrink: 0; }

  /* Variants */
  .phase-option-label {
    font-size: 12px; font-weight: 700;
    letter-spacing: 1px; text-transform: uppercase;
    color: var(--charcoal); margin-bottom: 8px;
    display: flex; align-items: center; gap: 6px;
  }
  .phase-option-selected {
    font-weight: 400; text-transform: none;
    letter-spacing: 0; color: var(--muted);
  }
  .phase-variant-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .phase-variant-btn {
    padding: 9px 16px;
    border: 1.5px solid var(--line);
    border-radius: 4px; background: #fff;
    font-size: 13px; font-weight: 600;
    cursor: pointer; transition: all .2s;
    font-family: inherit; color: var(--charcoal);
  }
  .phase-variant-btn:hover { border-color: var(--terracotta); }
  .phase-variant-btn.active {
    border-color: var(--terracotta);
    background: var(--terracotta); color: #fff;
  }

  /* Add to cart row */
  .phase-atc-row { display: flex; gap: 10px; margin-bottom: 16px; align-items: stretch; }
  .phase-qty {
    display: flex; align-items: center;
    border: 1.5px solid var(--line); border-radius: 4px;
    overflow: hidden; background: #fff; flex-shrink: 0;
  }
  .phase-qty-btn {
    width: 38px; height: 100%;
    font-size: 20px; background: none; border: none;
    color: var(--charcoal); cursor: pointer;
    font-family: inherit; transition: background .2s;
    display: flex; align-items: center; justify-content: center;
  }
  .phase-qty-btn:hover { background: var(--cream-dark); }
  .phase-qty-num {
    width: 40px; text-align: center;
    font-size: 15px; font-weight: 600; color: var(--charcoal);
  }
  .phase-btn-atc {
    flex: 1; padding: 15px 20px;
    background: var(--terracotta); color: #fff;
    border: none; border-radius: 4px;
    font-size: 13px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: all .25s;
    font-family: inherit;
  }
  .phase-btn-atc:hover { background: var(--terracotta-dark); transform: translateY(-1px); box-shadow: 0 8px 24px rgba(201,123,92,.3); }

  /* Micro-trust pills */
  .phase-micro-trust {
    display: flex; gap: 12px; flex-wrap: wrap;
    padding: 14px 0; border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .phase-micro-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--muted); font-weight: 500;
  }
  .phase-micro-item .mi-icon { font-size: 15px; }

  /* Why it works */
  .phase-why-title {
    font-size: 12px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--charcoal); margin-bottom: 12px;
  }
  .phase-why-list { list-style: none; margin-bottom: 28px; }
  .phase-why-list li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 14px; line-height: 1.6; color: var(--charcoal);
    padding: 8px 0; border-bottom: 1px solid var(--line);
  }
  .phase-why-list li:last-child { border-bottom: none; }
  .phase-why-icon { color: var(--terracotta); flex-shrink: 0; margin-top: 2px; font-size: 14px; }

  /* Accordion */
  .phase-accordion { border-top: 1px solid var(--line); margin-top: 8px; }
  .phase-acc-item  { border-bottom: 1px solid var(--line); }
  .phase-acc-head  {
    display: flex; justify-content: space-between;
    align-items: center; padding: 17px 0;
    cursor: pointer; background: none;
    border: none; width: 100%; text-align: left;
    font-family: inherit; gap: 12px;
  }
  .phase-acc-label { font-size: 14px; font-weight: 600; color: var(--charcoal); }
  .phase-acc-icon  {
    font-size: 22px; color: var(--terracotta);
    transition: transform .28s; flex-shrink: 0; line-height: 1;
  }
  .phase-acc-item.open .phase-acc-icon { transform: rotate(45deg); }
  .phase-acc-body  {
    max-height: 0; overflow: hidden;
    transition: max-height .35s ease;
  }
  .phase-acc-item.open .phase-acc-body { max-height: 900px; }
  .phase-acc-inner {
    padding-bottom: 20px;
    font-size: 14px; color: var(--muted); line-height: 1.8;
  }
  .phase-acc-inner p   { margin-bottom: 10px; }
  .phase-acc-inner ul  { list-style: none; margin-top: 8px; }
  .phase-acc-inner li  {
    padding: 5px 0 5px 18px; position: relative;
    line-height: 1.6;
  }
  .phase-acc-inner li::before {
    content: '→'; position: absolute; left: 0;
    color: var(--terracotta); font-size: 11px; top: 7px;
  }

  /* Ingredient grid inside accordion */
  .phase-ing-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; margin-top: 12px;
  }
  @media (max-width: 500px) { .phase-ing-grid { grid-template-columns: 1fr; } }
  .phase-ing-card {
    background: var(--cream); border: 1px solid var(--line);
    border-radius: 6px; padding: 12px 14px;
  }
  .phase-ing-name { font-size: 13px; font-weight: 700; color: var(--charcoal); margin-bottom: 3px; }
  .phase-ing-desc { font-size: 12px; color: var(--muted); line-height: 1.5; }

  /* ── Pullquote strip ─────────────────────────────── */
  .phase-pullquote {
    padding: 64px 0;
    background: var(--charcoal); color: #fff;
    text-align: center;
  }
  .phase-pq-stars { color: #E8A838; font-size: 20px; letter-spacing: 3px; margin-bottom: 14px; }
  .phase-pq-text  {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(20px, 2.8vw, 30px);
    font-style: italic; line-height: 1.45;
    color: #fff; max-width: 740px;
    margin: 0 auto 18px;
  }
  .phase-pq-attr { font-size: 13px; color: rgba(255,255,255,.55); }

  /* ── Reviews section ─────────────────────────────── */
  .phase-reviews-section {
    padding: 80px 0;
    background: var(--cream-dark);
  }
  .phase-rev-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 60px;
    align-items: start;
  }
  @media (max-width: 800px) { .phase-rev-layout { grid-template-columns: 1fr; gap: 32px; } }

  /* Summary panel */
  .phase-rev-score-big {
    font-family: 'DM Serif Display', serif;
    font-size: 84px; line-height: 1;
    color: var(--charcoal); margin-bottom: 6px;
  }
  .phase-rev-stars-big { color: #E8A838; font-size: 20px; letter-spacing: 2px; margin-bottom: 8px; }
  .phase-rev-total { font-size: 13px; color: var(--muted); margin-bottom: 20px; }
  .phase-bar-row  {
    display: flex; align-items: center;
    gap: 9px; margin-bottom: 6px; font-size: 12px; color: var(--muted);
  }
  .phase-bar-lbl  { width: 28px; text-align: right; flex-shrink: 0; }
  .phase-bar-track {
    flex: 1; height: 6px; background: var(--line);
    border-radius: 3px; overflow: hidden;
  }
  .phase-bar-fill {
    height: 100%; background: #E8A838;
    border-radius: 3px; transition: width .6s ease;
  }
  .phase-bar-pct  { width: 28px; flex-shrink: 0; }

  /* Review list header */
  .phase-rev-header {
    display: flex; justify-content: space-between;
    align-items: center; flex-wrap: wrap; gap: 12px;
    margin-bottom: 24px;
  }
  .phase-rev-header-title {
    font-family: 'DM Serif Display', serif;
    font-size: 24px; color: var(--charcoal);
  }
  .phase-rev-filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .phase-rev-filter {
    padding: 7px 14px; border-radius: 20px; font-size: 12px;
    font-weight: 600; border: 1.5px solid var(--line);
    background: #fff; color: var(--muted);
    cursor: pointer; transition: all .2s; font-family: inherit;
  }
  .phase-rev-filter.active {
    border-color: var(--terracotta);
    color: var(--terracotta); background: rgba(201,123,92,.07);
  }

  /* Review cards */
  .phase-rev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 960px) { .phase-rev-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 520px)  { .phase-rev-grid { grid-template-columns: 1fr; } }

  .phase-rev-card {
    background: #fff; border: 1px solid var(--line);
    border-radius: 8px; padding: 22px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .phase-rev-card.rev-highlight {
    background: var(--charcoal); border-color: var(--charcoal);
  }
  .phase-rev-top   { display: flex; justify-content: space-between; align-items: flex-start; }
  .phase-rev-s     { color: #E8A838; font-size: 12px; letter-spacing: 1px; }
  .phase-rev-card.rev-highlight .phase-rev-s { color: var(--gold); }
  .phase-rev-date  { font-size: 11px; color: var(--muted); }
  .phase-rev-card.rev-highlight .phase-rev-date { color: rgba(255,255,255,.4); }
  .phase-rev-title { font-size: 14px; font-weight: 700; color: var(--charcoal); }
  .phase-rev-card.rev-highlight .phase-rev-title { color: #fff; }
  .phase-rev-body  { font-size: 13px; color: var(--muted); line-height: 1.7; flex: 1; }
  .phase-rev-card.rev-highlight .phase-rev-body { color: rgba(255,255,255,.8); }
  .phase-rev-foot  {
    display: flex; align-items: center; gap: 10px;
    padding-top: 12px; border-top: 1px solid var(--line);
  }
  .phase-rev-card.rev-highlight .phase-rev-foot { border-color: rgba(255,255,255,.12); }
  .phase-rev-ava   {
    width: 34px; height: 34px; border-radius: 50%;
    object-fit: cover; flex-shrink: 0; display: flex;
    align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
    background: var(--cream-dark); color: var(--terracotta);
    overflow: hidden;
  }
  .phase-rev-name  { font-size: 13px; font-weight: 700; color: var(--charcoal); }
  .phase-rev-card.rev-highlight .phase-rev-name { color: #fff; }
  .phase-rev-meta  { font-size: 11px; color: var(--muted); }
  .phase-rev-card.rev-highlight .phase-rev-meta { color: rgba(255,255,255,.45); }
  .phase-rev-vbadge {
    margin-left: auto; font-size: 11px;
    color: var(--sage); font-weight: 700;
    white-space: nowrap;
  }
  .phase-rev-card.rev-highlight .phase-rev-vbadge { color: #7BBFA0; }

  /* ── Cross-sell ──────────────────────────────────── */
  .phase-cross-sell { padding: 80px 0; background: var(--cream); }
  .phase-cs-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 18px; margin-top: 40px;
  }
  @media (max-width: 900px) { .phase-cs-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 480px)  { .phase-cs-grid { grid-template-columns: 1fr 1fr; gap: 12px; } }

  .phase-cs-card {
    background: #fff; border: 1px solid var(--line);
    border-radius: 8px; overflow: hidden;
    transition: transform .25s, box-shadow .25s;
    text-decoration: none; color: inherit; display: block;
  }
  .phase-cs-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(60,40,30,.1);
  }
  .phase-cs-img  {
    width: 100%; aspect-ratio: 1/1;
    object-fit: cover; display: block;
    background: var(--cream-dark);
  }
  .phase-cs-body { padding: 14px 16px; }
  .phase-cs-name { font-size: 13px; font-weight: 600; color: var(--charcoal); margin-bottom: 4px; line-height: 1.4; }
  .phase-cs-price { font-size: 14px; font-weight: 700; color: var(--terracotta); }
</style>

{%- assign cv = product.selected_or_first_available_variant -%}

<div class="phase-product-page">

  <!-- BREADCRUMB -->
  <div class="phase-breadcrumb">
    <div class="container">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/collections/all">Shop All</a>
      <span class="sep">›</span>
      {{ product.title }}
    </div>
  </div>

  <!-- MAIN -->
  <section class="phase-product-main">
    <div class="container">
      <div class="phase-product-layout">

        <!-- ══ GALLERY ══ -->
        <div class="phase-gallery">
          <div class="phase-gallery-main" id="phase-gallery-main">
            {%- if product.images.size > 0 -%}
              <img id="phase-hero-img"
                src="{{ product.images[0] | image_url: width: 1000 }}"
                alt="{{ product.images[0].alt | default: product.title }}"
                loading="eager" />
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=1000&q=80" alt="{{ product.title }}" />
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
              <div class="phase-gallery-badge">Save {{ pct }}%</div>
            {%- endif -%}
            <div class="phase-gallery-badge-green">✓ Clinician Vetted</div>
          </div>

          {%- if product.images.size > 1 -%}
          <div class="phase-gallery-thumbs">
            {%- for img in product.images limit: 8 -%}
              <div class="phase-thumb {% if forloop.first %}active{% endif %}"
                   onclick="phaseSetImg(this,'{{ img | image_url: width: 1000 }}','{{ img.alt | default: product.title | escape }}')">
                <img src="{{ img | image_url: width: 180 }}"
                     alt="{{ img.alt | default: product.title }}" loading="lazy" />
              </div>
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>

        <!-- ══ INFO ══ -->
        <div class="phase-product-info">

          <div class="phase-product-vendor">Phase® — Clinician Curated</div>
          <h1 class="phase-product-title">{{ product.title }}</h1>

          <!-- Rating row -->
          <div class="phase-rating-row">
            <span class="phase-stars-gold">★★★★★</span>
            <span class="phase-rating-score">{{ section.settings.avg_rating | default: 4.8 }}</span>
            <button class="phase-rating-link" onclick="document.getElementById('phase-reviews').scrollIntoView({behavior:'smooth'})">
              {{ section.settings.review_count | default: 127 }} verified reviews
            </button>
            <span class="phase-verified-pill">✓ Verified Buyers</span>
          </div>

          <!-- Price -->
          <div class="phase-price-row">
            <span class="phase-price" id="phase-price">{{ cv.price | money }}</span>
            {%- if cv.compare_at_price > cv.price -%}
              <span class="phase-compare">{{ cv.compare_at_price | money }}</span>
              <span class="phase-save-pill">Save {{ cv.compare_at_price | minus: cv.price | money }}</span>
            {%- endif -%}
          </div>

          <!-- Subscribe / one-time toggle -->
          <div class="phase-sub-toggle">
            <button class="phase-sub-btn" id="phase-sub-once" onclick="phaseSubMode('once')">
              <span class="phase-sub-btn-label">One-time purchase</span>
              <span class="phase-sub-btn-note">{{ cv.price | money }}</span>
            </button>
            <div class="phase-sub-divider"></div>
            <button class="phase-sub-btn active" id="phase-sub-sub" onclick="phaseSubMode('sub')">
              <span class="phase-sub-btn-label">Subscribe &amp; save 15%</span>
              <span class="phase-sub-btn-note" style="color:var(--terracotta);font-weight:600">
                {{ cv.price | times: 0.85 | money }} / month · Cancel anytime
              </span>
            </button>
          </div>

          <!-- Variant options -->
          {%- if product.variants.size > 1 -%}
            {%- for option in product.options_with_values -%}
              <div class="phase-option-label">
                {{ option.name }}
                <span class="phase-option-selected" id="sel-{{ option.position }}">— {{ option.values.first }}</span>
              </div>
              <div class="phase-variant-row">
                {%- for v in option.values -%}
                  <button class="phase-variant-btn {% if forloop.first %}active{% endif %}"
                          onclick="phasePickVariant(this, '{{ v | escape }}', {{ option.position }})">
                    {{ v }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          {%- endif -%}

          <!-- Add to cart -->
          <form action="/cart/add" method="post" id="phase-atc-form">
            <input type="hidden" name="id"       value="{{ cv.id }}" id="phase-vid">
            <input type="hidden" name="quantity"  value="1" id="phase-qty-input">
            <div class="phase-atc-row">
              <div class="phase-qty">
                <button type="button" class="phase-qty-btn" onclick="phaseQty(-1)">−</button>
                <span class="phase-qty-num" id="phase-qty-num">1</span>
                <button type="button" class="phase-qty-btn" onclick="phaseQty(1)">+</button>
              </div>
              <button type="submit" class="phase-btn-atc">Add to Cart →</button>
            </div>
          </form>

          <!-- Micro-trust -->
          <div class="phase-micro-trust">
            <div class="phase-micro-item"><span class="mi-icon">🚚</span> Free shipping $50+</div>
            <div class="phase-micro-item"><span class="mi-icon">↩</span> 60-day money-back</div>
            <div class="phase-micro-item"><span class="mi-icon">🔬</span> Clinically studied</div>
            <div class="phase-micro-item"><span class="mi-icon">🌿</span> Hormone-free</div>
          </div>

          <!-- Why it works -->
          <div class="phase-why-title">Why it works</div>
