<script>
/* ── Gallery ─────────────────────────── */
function phaseSetImg(thumb, src, alt) {
  var hero = document.getElementById('phase-hero-img');
  hero.style.opacity = '0.6';
  setTimeout(function() {
    hero.src = src;
    hero.alt = alt;
    hero.style.opacity = '1';
  }, 100);
  document.querySelectorAll('.phase-thumb').forEach(function(t){ t.classList.remove('active'); });
  thumb.classList.add('active');
}

/* ── Accordion ───────────────────────── */
function phaseAcc(btn) {
  var item = btn.closest('.phase-acc-item');
  item.classList.toggle('open');
}

/* ── Subscribe toggle ────────────────── */
function phaseSubMode(mode) {
  var once = document.getElementById('phase-sub-once');
  var sub  = document.getElementById('phase-sub-sub');
  once.classList.toggle('active', mode === 'once');
  sub.classList.toggle('active',  mode === 'sub');
}

/* ── Qty ─────────────────────────────── */
function phaseQty(delta) {
  var el = document.getElementById('phase-qty-num');
  var n  = Math.max(1, Math.min(10, parseInt(el.textContent) + delta));
  el.textContent = n;
  document.getElementById('phase-qty-input').value = n;
}

/* ── Variant selector ────────────────── */
function phasePickVariant(btn, val, pos) {
  var row = btn.closest('.phase-variant-row');
  row.querySelectorAll('.phase-variant-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  var selEl = document.getElementById('sel-' + pos);
  if (selEl) selEl.textContent = '— ' + val;
  /* Match variant id */
  var variants = {{ product.variants | json }};
  var selectedOptions = [];
  document.querySelectorAll('.phase-variant-row').forEach(function(r, i) {
    var a = r.querySelector('.phase-variant-btn.active');
    selectedOptions[i] = a ? a.textContent.trim() : '';
  });
  variants.forEach(function(v) {
    var match = v.options.every(function(o, i) { return selectedOptions[i] === o; });
    if (match) {
      document.getElementById('phase-vid').value = v.id;
      if (v.price) {
        var p = document.getElementById('phase-price');
        if (p) p.textContent = formatMoney(v.price);
      }
    }
  });
}

function formatMoney(cents) {
  return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
}

/* ── Review filter ───────────────────── */
function phaseRevFilter(f, btn) {
  document.querySelectorAll('.phase-rev-filter').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('.phase-rev-card').forEach(function(c) {
    var show = true;
    if (f === '5')        show = c.dataset.stars === '5';
    if (f === 'verified') show = c.dataset.verified !== 'false';
    c.style.display = show ? '' : 'none';
  });
}
</script>

