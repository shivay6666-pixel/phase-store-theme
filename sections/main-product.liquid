{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}

<style>
  .product-page { max-width: 1200px; margin: 48px auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .product-page__media img { border-radius: 12px; width: 100%; }
  .product-page__title { font-family: var(--serif); font-size: 40px; line-height: 1.1; margin: 0 0 12px; }
  .product-page__price { font-size: 22px; color: var(--terracotta); margin-bottom: 24px; }
  .product-page__desc { font-size: 16px; line-height: 1.7; color: var(--charcoal); margin-bottom: 28px; }
  .product-form__buttons { display: flex; gap: 12px; align-items: center; }
  .product-form__cart { background: var(--charcoal); color: var(--cream); padding: 16px 28px; border: none; border-radius: 999px; font-size: 15px; font-weight: 500; cursor: pointer; letter-spacing: 0.02em; }
  .product-form__cart:hover { background: var(--terracotta); }
  .product-form__cart[disabled] { opacity: 0.5; cursor: not-allowed; }
  .product-form__qty { width: 64px; padding: 14px 12px; border: 1px solid rgba(44,44,44,0.15); border-radius: 999px; text-align: center; }
  .product-form__variants { margin-bottom: 20px; }
  .product-form__variants select { padding: 12px 16px; border: 1px solid rgba(44,44,44,0.15); border-radius: 8px; font-size: 14px; min-width: 200px; }
  @media (max-width: 768px) { .product-page { grid-template-columns: 1fr; gap: 24px; } }
</style>

<div class="product-page">
  <div class="product-page__media">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
    {% endif %}
  </div>
  <div class="product-page__info">
    <h1 class="product-page__title">{{ product.title }}</h1>
    <div class="product-page__price">{{ product.selected_or_first_available_variant.price | money }}</div>
    <div class="product-page__desc">{{ product.description }}</div>

    {% form 'product', product %}
      {% if product.has_only_default_variant == false %}
        <div class="product-form__variants">
          <label for="variant-select">Option:</label>
          <select id="variant-select" name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
              </option>
            {% endfor %}
          </select>
        </div>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endif %}

      <div class="product-form__buttons">
        <input type="number" name="quantity" value="1" min="1" class="product-form__qty">
        <button type="submit" name="add" class="product-form__cart" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
      </div>
    {% endform %}
  </div>
</div>
